{
  "lexicon": 1,
  "id": "io.sunred.relay.getFollowerCount",
  "defs": {
    "main": {
      "type": "query",
      "description": "Returns the globally accurate follower count for a DID (unique followers across all tracked repos).",
      "parameters": {
        "type": "params",
        "required": ["did"],
        "properties": {
          "did": {
            "type": "string",
            "description": "The DID to query the follower count for."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "count"],
          "properties": {
            "did": {
              "type": "string"
            },
            "count": {
              "type": "integer",
              "description": "Total number of follow records targeting this DID across all tracked repos."
            }
          }
        }
      }
    }
  }
}
