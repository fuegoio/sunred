---
import Base from "../layouts/Base.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import Cta from "../components/Cta.astro"
import PageHero from "../components/PageHero.astro"
import Closing from "../components/Closing.astro"
import SectionHead from "../components/SectionHead.astro"
import CodeSample from "../components/CodeSample.astro"
import MockWindow from "../components/MockWindow.astro"

const loginUrl = "/login"
const selfHostUrl = "https://github.com/fuegoio/sunred"

const featureSection = "border-t border-border py-[clamp(4rem,10vh,6.5rem)]"
const featureSectionAlt =
  "bg-[color-mix(in_oklab,var(--background)_88%,black)]"
const split =
  "grid grid-cols-1 items-center gap-[clamp(2.5rem,6vw,4rem)] min-[880px]:grid-cols-2"
const tag =
  "inline-flex items-center gap-2 rounded-full border border-border bg-[color-mix(in_oklab,var(--card)_60%,transparent)] px-[0.7rem] py-[0.35rem] font-mono text-[0.75rem] font-medium text-muted-foreground"
const tagDot =
  "h-[0.45rem] w-[0.45rem] rounded-full bg-primary shadow-[0_0_0_3px_color-mix(in_oklab,var(--primary)_22%,transparent)]"
const arrow =
  '<svg class="h-[17px] w-[17px] shrink-0" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4.5 10h11m0 0-4.5-4.5M15.5 10 11 14.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>'

const prose =
  "mt-6 max-w-[40rem] text-[1.125rem] leading-[1.75] [&_p]:m-0 [&_p]:text-muted-foreground [&_p+p]:mt-5 [&_strong]:font-semibold [&_strong]:text-foreground [&_a]:text-[color-mix(in_oklab,var(--primary)_85%,var(--foreground))] [&_a]:underline [&_a]:underline-offset-[0.15em] [&_a]:decoration-[color-mix(in_oklab,var(--primary)_35%,transparent)]"

const spSearch =
  "mb-4 flex items-center gap-2 rounded-[0.5rem] border border-border bg-background px-[0.85rem] py-[0.6rem]"
const spResult =
  "flex items-center gap-3 rounded-[0.5rem] border border-border bg-[color-mix(in_oklab,var(--card)_60%,transparent)] px-[0.75rem] py-[0.65rem] transition-colors duration-150 hover:border-input"
const spFollow =
  "shrink-0 rounded-[0.4rem] border border-input px-[0.7rem] py-[0.3rem] text-[0.75rem] font-semibold text-muted-foreground"
const shareEntry =
  "mb-2 rounded-[0.55rem] border border-border bg-[color-mix(in_oklab,var(--background)_40%,transparent)] px-4 py-[0.85rem]"
const shareAction =
  "inline-flex items-center gap-[0.3rem] text-[0.75rem] font-medium text-muted-foreground/70"
---

<Base
  title="Social — Sunred"
  description="Follow people, share articles, and see what others are reading. Federated on the AT Protocol."
>
  <a
    href="#main"
    class="absolute -top-full left-4 z-[100] rounded-[0.5rem] bg-primary px-5 py-[0.625rem] text-sm font-semibold text-primary-foreground transition-[top] duration-200 focus:top-4"
  >
    Skip to content
  </a>
  <Nav active="social" />

  <PageHero label="Social">
    <span class:list={[tag, "mb-7"]}>
      <span class={tagDot}></span>
      Federated on the AT Protocol
    </span>
    <h1
      class="mt-0 mb-6 font-sans text-[clamp(2.5rem,7vw,4.5rem)] font-semibold leading-[1.02] tracking-[-0.04em] text-foreground [text-wrap:balance]"
    >
      Reading is better<br />with people you trust.
    </h1>
    <p
      class="mt-0 max-w-[38rem] text-[clamp(1.125rem,2.5vw,1.375rem)] leading-[1.55] text-muted-foreground [text-wrap:pretty]"
    >
      Follow people and see the articles they share in your timeline.
      Your social graph runs on the same protocol as Bluesky — it travels
      with you across instances, not locked to one server.
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-3">
      <Cta href={loginUrl} variant="primary">
        <span>Open the app</span>
        <Fragment set:html={arrow} />
      </Cta>
      <Cta href="https://sunred.dev/docs/product/social" variant="ghost">Read the docs</Cta>
    </div>
  </PageHero>

  <main id="main">
    <!-- FOLLOW -->
    <section class={featureSection} aria-labelledby="follow-heading">
      <div class="mx-auto max-w-[72rem] px-[clamp(1.25rem,4vw,2.5rem)]">
        <div class={split}>
          <div class="max-w-[36rem]">
            <SectionHead mark="/ follow" headlineId="follow-heading" lede="Find people by handle or name. Search spans your instance and, when a relay is configured, every other instance too.">
              Follow people, not algorithms.
            </SectionHead>
            <div class={prose}>
              <p>When you follow someone, Sunred <strong>backfills their existing shares</strong> into your timeline — you don't miss what they shared before you found them.</p>
              <p>The people you follow appear under <strong>Follows</strong> in the sidebar, right below your feeds. Click a name to open their profile and follow or unfollow.</p>
            </div>
          </div>
          <div aria-hidden="true">
            <MockWindow path="Find people" class="max-w-[28rem]">
              <div class="p-4">
                <div class={spSearch}>
                  <span class="text-base text-muted-foreground/70">⌕</span>
                  <span class="font-mono text-[0.875rem] text-foreground">elena</span>
                  <span class="h-4 w-[1.5px] rounded-[1px] bg-primary"></span>
                </div>
                <div class="flex flex-col gap-2">
                  <div class={spResult}>
                    <span class="h-8 w-8 shrink-0 rounded-full bg-[color-mix(in_oklab,var(--primary)_40%,oklch(0.5_0.01_50))]"></span>
                    <div class="flex min-w-0 flex-1 flex-col gap-[0.15rem]">
                      <span class="text-[0.875rem] font-semibold text-foreground">Elena Vasquez</span>
                      <span class="font-mono text-[0.72rem] text-muted-foreground/70">@elena · sunred.app</span>
                    </div>
                    <span class={spFollow}>Following</span>
                  </div>
                  <div class={spResult}>
                    <span class="h-8 w-8 shrink-0 rounded-full bg-[color-mix(in_oklab,oklch(0.6_0.12_200)_50%,oklch(0.5_0.01_50))]"></span>
                    <div class="flex min-w-0 flex-1 flex-col gap-[0.15rem]">
                      <span class="text-[0.875rem] font-semibold text-foreground">Elena K.</span>
                      <span class="font-mono text-[0.72rem] text-muted-foreground/70">@elena.dev · relay</span>
                    </div>
                    <span class:list={[spFollow, "border-primary bg-primary text-primary-foreground"]}>Follow</span>
                  </div>
                  <div class={spResult}>
                    <span class="h-8 w-8 shrink-0 rounded-full bg-[color-mix(in_oklab,oklch(0.6_0.12_300)_50%,oklch(0.5_0.01_50))]"></span>
                    <div class="flex min-w-0 flex-1 flex-col gap-[0.15rem]">
                      <span class="text-[0.875rem] font-semibold text-foreground">elenas.blog</span>
                      <span class="font-mono text-[0.72rem] text-muted-foreground/70">@elena · other.instance</span>
                    </div>
                    <span class:list={[spFollow, "border-primary bg-primary text-primary-foreground"]}>Follow</span>
                  </div>
                </div>
              </div>
            </MockWindow>
          </div>
        </div>
      </div>
    </section>

    <!-- SHARE -->
    <section class:list={[featureSection, featureSectionAlt]} aria-labelledby="share-heading">
      <div class="mx-auto max-w-[72rem] px-[clamp(1.25rem,4vw,2.5rem)]">
        <div class={split}>
          <div class="max-w-[36rem] order-2 min-[880px]:order-1">
            <SectionHead mark="/ share" headlineId="share-heading" lede="Click the share icon on any entry. Your followers see it in their timeline with your name attached.">
              One click to share.
            </SectionHead>
            <div class={prose}>
              <p>Sharing is an <strong>independent action</strong> — it doesn't change read status or starring. Share something you've already read, or star something you've shared.</p>
              <p>Shared articles appear in your followers' <strong>Unread</strong> and <strong>All</strong> views alongside their own subscriptions. If the article comes from a feed they don't subscribe to, they get a <strong>Subscribe</strong> button to add the source in one click.</p>
            </div>
          </div>
          <div aria-hidden="true" class="order-1 min-[880px]:order-2">
            <MockWindow path="sunred — Unread">
              <div class="p-[0.6rem]">
                <div class:list={[shareEntry, "border-[color-mix(in_oklab,var(--primary)_30%,var(--input))]"]}>
                  <div class="mb-[0.3rem] flex gap-[0.6rem] font-mono text-[0.6875rem] text-muted-foreground/70">
                    <span class="text-[color-mix(in_oklab,var(--primary)_80%,var(--muted-foreground))]">rust-lang.org</span>
                    <span>5h</span>
                  </div>
                  <div class="mb-1 text-[0.9375rem] font-semibold text-foreground">Rust 2026 roadmap</div>
                  <div class="mb-[0.6rem] text-[0.8rem] leading-[1.5] text-muted-foreground">A look at the language team's direction for the next edition…</div>
                  <div class="flex gap-3">
                    <span class:list={[shareAction, "text-[color-mix(in_oklab,var(--primary)_85%,var(--foreground))]"]}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="m16 6-4-4-4 4"/><path d="M12 2v13"/></svg>
                      Shared
                    </span>
                    <span class={shareAction}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.5 2 9.6 8.6 3 10.5l6.6 1.9L11.5 19l1.9-6.6 6.6-1.9-6.6-1.9L11.5 2Z"/></svg>
                      Star
                    </span>
                  </div>
                </div>
                <div class={shareEntry}>
                  <div class="mb-[0.3rem] flex gap-[0.6rem] font-mono text-[0.6875rem] text-muted-foreground/70">
                    <span class="text-[color-mix(in_oklab,var(--primary)_80%,var(--muted-foreground))]">selfhosted.show</span>
                    <span>8h</span>
                  </div>
                  <div class="mb-1 text-[0.9375rem] font-semibold text-foreground">The end of Moore's law (again)</div>
                  <div class="mb-[0.6rem] text-[0.8rem] leading-[1.5] text-muted-foreground">Density gains slow, and what that means for the home lab…</div>
                  <div class="flex gap-3">
                    <span class={shareAction}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="m16 6-4-4-4 4"/><path d="M12 2v13"/></svg>
                      Share
                    </span>
                    <span class={shareAction}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.5 2 9.6 8.6 3 10.5l6.6 1.9L11.5 19l1.9-6.6 6.6-1.9-6.6-1.9L11.5 2Z"/></svg>
                      Star
                    </span>
                  </div>
                </div>
              </div>
            </MockWindow>
          </div>
        </div>
      </div>
    </section>

    <!-- PROFILES -->
    <section class={featureSection} aria-labelledby="profiles-heading">
      <div class="mx-auto max-w-[72rem] px-[clamp(1.25rem,4vw,2.5rem)]">
        <div class={split}>
          <div class="max-w-[36rem]">
            <SectionHead mark="/ profiles" headlineId="profiles-heading" lede={`Every user gets a public page at /users/{handle} with their shared articles, public feeds, and follower counts.`}>
              Your profile is public.
            </SectionHead>
            <div class={prose}>
              <p>Profiles show follower and following counts with a <strong>federated split</strong> — how many are on your instance vs. how many are on other instances via the relay.</p>
              <p>Set your display name and bio under Settings. These are cached from your standard AT Proto profile record — the same one Bluesky uses.</p>
            </div>
          </div>
          <div aria-hidden="true">
            <MockWindow path="/users/@elena" class="max-w-[28rem]">
              <div class="px-5 pb-4 pt-5">
                <div class="mb-5 flex items-start gap-[0.85rem]">
                  <span class="h-12 w-12 shrink-0 rounded-full bg-[color-mix(in_oklab,var(--primary)_40%,oklch(0.5_0.01_50))]"></span>
                  <div class="flex flex-1 flex-col gap-[0.1rem]">
                    <span class="text-base font-semibold text-foreground">Elena Vasquez</span>
                    <span class="font-mono text-[0.78rem] text-muted-foreground/70">@elena</span>
                    <p class="mt-[0.4rem] text-[0.8125rem] leading-[1.5] text-muted-foreground">Reading Rust, systems, and the open web. Sharing what matters.</p>
                  </div>
                  <span class="shrink-0 rounded-[0.4rem] border border-input px-[0.8rem] py-[0.35rem] text-[0.75rem] font-semibold text-muted-foreground">Following</span>
                </div>
                <div class="mb-3 flex gap-7 border-b border-border pb-4">
                  <div class="flex flex-col gap-[0.1rem]">
                    <span class="text-[0.9375rem] font-semibold text-foreground">1,247</span>
                    <span class="text-[0.72rem] text-muted-foreground/70">followers</span>
                  </div>
                  <div class="flex flex-col gap-[0.1rem]">
                    <span class="text-[0.9375rem] font-semibold text-foreground">89</span>
                    <span class="text-[0.72rem] text-muted-foreground/70">following</span>
                  </div>
                  <div class="flex flex-col gap-[0.1rem]">
                    <span class="text-[0.9375rem] font-semibold text-foreground">34</span>
                    <span class="text-[0.72rem] text-muted-foreground/70">articles shared</span>
                  </div>
                </div>
                <div class="mb-2 flex gap-5 border-b border-border">
                  <span class="-mb-px border-b-[1.5px] border-primary pb-[0.6rem] text-[0.8125rem] font-medium text-foreground">Articles</span>
                  <span class="-mb-px border-b-[1.5px] border-transparent pb-[0.6rem] text-[0.8125rem] font-medium text-muted-foreground/70">Feeds</span>
                </div>
                <div class="flex flex-col gap-[0.1rem]">
                  <div class="flex items-center justify-between border-b border-border py-[0.6rem] last:border-b-0">
                    <span class="text-[0.8125rem] font-medium text-foreground">Why RSS still matters</span>
                    <span class="font-mono text-[0.6875rem] text-muted-foreground/70">planet4.local · 2h</span>
                  </div>
                  <div class="flex items-center justify-between border-b border-border py-[0.6rem] last:border-b-0">
                    <span class="text-[0.8125rem] font-medium text-foreground">Rust 2026 roadmap</span>
                    <span class="font-mono text-[0.6875rem] text-muted-foreground/70">rust-lang.org · 5h</span>
                  </div>
                  <div class="flex items-center justify-between border-b border-border py-[0.6rem] last:border-b-0">
                    <span class="text-[0.8125rem] font-medium text-foreground">A field guide to OPML</span>
                    <span class="font-mono text-[0.6875rem] text-muted-foreground/70">planet4.local · 1d</span>
                  </div>
                </div>
              </div>
            </MockWindow>
          </div>
        </div>
      </div>
    </section>

    <!-- FEDERATION -->
    <section class:list={[featureSection, featureSectionAlt]} aria-labelledby="federation-heading">
      <div class="mx-auto max-w-[72rem] px-[clamp(1.25rem,4vw,2.5rem)]">
        <div class={split}>
          <div class="max-w-[36rem] order-2 min-[880px]:order-1">
            <SectionHead mark="/ federation" headlineId="federation-heading" lede="Follows and shares are AT Protocol records on your own PDS. Sign into another Sunred instance and your social graph is there.">
              Your graph travels with you.
            </SectionHead>
            <div class={prose}>
              <p>Sunred uses the AT Protocol for identity and federation — the same protocol Bluesky runs on. Your account is an AT Proto identity with its own DID and PDS (personal data server).</p>
              <p>Follows, shares, and feed subscriptions are <strong>records on your PDS</strong>, not rows in one server's database. A relay aggregates them across instances so follower counts, share counts, and search results span the whole network, not just your corner of it.</p>
              <p>You don't need a Bluesky account. You don't need to understand any of this. It just means your social graph is <strong>yours</strong>, and it moves when you do.</p>
            </div>
          </div>
          <div aria-hidden="true" class="order-1 min-[880px]:order-2">
            <div class="flex max-w-[28rem] flex-col items-center gap-6 rounded-[0.75rem] border border-border bg-[color-mix(in_oklab,var(--background)_40%,transparent)] p-8">
              <div class="flex flex-col items-center gap-[0.2rem] rounded-[0.6rem] border border-primary bg-[color-mix(in_oklab,var(--primary)_12%,transparent)] px-5 py-3">
                <span class="text-[0.625rem] text-primary">●</span>
                <span class="text-[0.8125rem] font-semibold text-foreground">Your PDS</span>
                <span class="font-mono text-[0.6875rem] text-muted-foreground/70">follows · shares · feeds</span>
              </div>
              <div class="flex h-6 flex-col gap-[0.4rem]" aria-hidden="true">
                <span class="h-full w-px bg-input"></span>
                <span class="h-full w-px bg-input"></span>
                <span class="h-full w-px bg-input"></span>
              </div>
              <div class="flex gap-3">
                {
                  [
                    { label: "Instance A", sub: "sunred.app" },
                    { label: "Instance B", sub: "self-hosted" },
                    { label: "Instance C", sub: "other.host" },
                  ].map((n) => (
                    <div class="flex flex-col items-center gap-[0.2rem] rounded-[0.6rem] border border-input bg-[color-mix(in_oklab,var(--card)_60%,transparent)] px-5 py-3">
                      <span class="text-[0.625rem] text-[color-mix(in_oklab,var(--primary)_70%,var(--muted-foreground))]">●</span>
                      <span class="text-[0.8125rem] font-semibold text-foreground">{n.label}</span>
                      <span class="font-mono text-[0.6875rem] text-muted-foreground/70">{n.sub}</span>
                    </div>
                  ))
                }
              </div>
              <div class="flex flex-col items-center gap-[0.15rem] rounded-[0.6rem] border border-dashed border-input px-5 py-2">
                <span class="font-mono text-[0.75rem] font-semibold text-muted-foreground">relay</span>
                <span class="text-[0.6875rem] text-muted-foreground/70">aggregates counts across instances</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CLI / API -->
    <section class={featureSection} aria-labelledby="cli-heading">
      <div class="mx-auto max-w-[64rem] px-[clamp(1.25rem,4vw,2.5rem)]">
        <SectionHead
          mark="/ cli"
          headlineId="cli-heading"
          lede="Follow, share, and search people without leaving your shell. Same REST API the web app uses."
        >
          Social from the terminal.
        </SectionHead>

        <CodeSample label="Social CLI sample">
          <span class="font-semibold text-primary">$</span> sunred search --users elena
            @elena           Elena Vasquez    sunred.app
            @elena.dev       Elena K.         relay → other.instance

          <span class="font-semibold text-primary">$</span> sunred follow @elena
          <span class="text-[oklch(0.6_0.012_50)]"># Now following @elena — backfilling 3 shares</span>

          <span class="font-semibold text-primary">$</span> sunred share 1
          <span class="text-[oklch(0.6_0.012_50)]"># Shared "Why RSS still matters" to 14 followers</span>

          <span class="font-semibold text-primary">$</span> sunred following
            @elena    Elena Vasquez    3 shares
            @kael     Kael Wright      1 share
        </CodeSample>
      </div>
    </section>
  </main>

  <Closing headline="Start following." lede="Find people, share what you read, and let your graph travel with you.">
    <Cta href={loginUrl} variant="primary">
      <span>Open the app</span>
      <Fragment set:html={arrow} />
    </Cta>
    <Cta href={selfHostUrl} variant="ghost">Self-host</Cta>
  </Closing>

  <Footer />
</Base>
