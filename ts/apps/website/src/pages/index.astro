---
import Base from "../layouts/Base.astro"
import Logo from "../components/Logo.astro"

// CTA targets. The marketing site is served at the same origin as the app
// (sunred.app) for logged-out visitors, so "Login" is a same-origin link to
// the app's /login route (the web proxy routes it to the Next app). After
// signing in, the proxy serves the app at "/".
const loginUrl = "/login"
const selfHostUrl = "https://github.com/fuegoio/sunred"
---

<Base>
  <a href="#positioning-heading" class="skip-link">Skip to content</a>

  <!-- ════════════════════════════════════════════════════════════════
       NAV — floating over the hero, transparent on dawn
  ═════════════════════════════════════════════════════════════════ -->
  <nav class="site-nav" aria-label="Primary">
    <a class="nav-brand" href="/">
      <Logo class="nav-mark" static />
      <span>Sunred</span>
    </a>
    <div class="nav-links">
      <a href="#features">Features</a>
      <a href="#interfaces">Interfaces</a>
      <a href="#faq">FAQ</a>
      <a href="https://sunred.dev/docs">Docs</a>
    </div>
    <div class="nav-cta">
      <a class="nav-link-login" href={loginUrl}>Login</a>
      <a class="cta cta-primary cta-sm" href={selfHostUrl}>Self-host</a>
    </div>
  </nav>

  <!-- ════════════════════════════════════════════════════════════════
       HERO — the dawn
       A deep warm sky. The sun (logo) rises from the left.
       "Sunred" appears as the light blooms. Then the tagline and CTAs.
  ═════════════════════════════════════════════════════════════════ -->
  <section class="hero" aria-label="Hero">
    <!-- Sky layers: base deep sky, warming layer (fades in as sun rises) -->
    <div class="sky-base" aria-hidden="true"></div>
    <div class="sky-warm-layer sky-warm" aria-hidden="true"></div>

    <!-- Drifting dawn haze low on the horizon -->
    <div class="haze haze-layer" aria-hidden="true"></div>

    <!-- The sun's glow, blooming behind the logo -->
    <div class="sun-glow" aria-hidden="true"></div>

    <!-- The sun itself -->
    <div class="sun-wrap">
      <Logo class="sun-logo-mark" />
    </div>

    <!-- Wordmark + tagline + CTAs -->
    <div class="hero-content">
      <h1 class="wordmark">Sunred</h1>
      <p class="tagline">
        A modern, self-hostable RSS reader. Clean API, multiple
        interfaces, one timeline.
      </p>

      <div class="cta-row">
        <a class="cta cta-primary" href={loginUrl}>
          <span>Login</span>
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path
              d="M4.5 10h11m0 0-4.5-4.5M15.5 10 11 14.5"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="cta cta-secondary" href={selfHostUrl}>
          Self-host
        </a>
      </div>
    </div>

    <!-- Scroll cue -->
    <div class="scroll-cue" aria-hidden="true">
      <svg width="20" height="32" viewBox="0 0 20 32" fill="none">
        <rect
          x="0.5"
          y="0.5"
          width="19"
          height="31"
          rx="9.5"
          stroke="currentColor"
          stroke-opacity="0.4"></rect>
        <circle cx="10" cy="9" r="2" fill="currentColor">
          <animate
            attributeName="cy"
            values="9;20;9"
            dur="2.4s"
            repeatCount="indefinite"
            calcMode="spline"
            keySplines="0.4 0 0.2 1; 0.4 0 0.2 1"
            keyTimes="0;0.5;1"></animate>
        </circle>
      </svg>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       BELOW THE FOLD — reading-first positioning
       Prose carries the message. A CLI sample shows the product.
  ═════════════════════════════════════════════════════════════════ -->
  <section class="positioning" aria-labelledby="positioning-heading">
    <div class="positioning-inner">
      <p class="kicker">The reader</p>
      <h2 id="positioning-heading" class="positioning-headline">
        Your feeds, your terms.
      </h2>

      <div class="positioning-body">
        <p>
          Sunred fetches RSS 2.0, Atom, and JSON Feed into a single
          timeline you actually want to read. No ads, no tracking, no
          algorithm deciding what reaches you. Just the sources you chose,
          in a calm space built for reading.
        </p>
        <p>
          It's self-hostable: run it on your own machine and own your data
          end to end. Or use the hosted version and skip the setup. Either
          way, the same clean REST API and the same interfaces (web,
          terminal, and CLI) connect you to your feeds from wherever you
          work.
        </p>
      </div>

      <!-- A CLI sample shows the product, not a restatement of the prose -->
      <div class="code-sample" role="region" aria-label="Sunred CLI sample">
        <div class="code-tabbar" aria-hidden="true">
          <span class="code-dot"></span>
          <span class="code-dot"></span>
          <span class="code-dot"></span>
          <span class="code-label">terminal</span>
        </div>
        <pre class="code-body"><code><span class="code-prompt">$</span> sunred feeds add https://example.com/feed.xml
<span class="code-prompt">$</span> sunred list --unread
<span class="code-comment"># 3 unread in Technology</span>
  planet4.local  Rust 2026 roadmap
  planet4.local  The end of Moore's law (again)
  planet4.local  Why RSS still matters

<span class="code-prompt">$</span> sunred read 1 --open</code></pre>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       FEATURES — what you get, in plain terms
  ═════════════════════════════════════════════════════════════════ -->
  <section id="features" class="features" aria-labelledby="features-heading">
    <div class="section-inner">
      <p class="kicker">What you get</p>
      <h2 id="features-heading" class="section-headline">
        Everything an RSS reader should be.
      </h2>
      <p class="section-lede">
        No feature bloat. No tracking. Just the tools you need to subscribe,
        read, and share.
      </p>

      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 11a9 9 0 0 1 9 9" /><path d="M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1" fill="currentColor" stroke="none" />
            </svg>
          </div>
          <h3>All feed formats</h3>
          <p>RSS 2.0, Atom 1.0, and JSON Feed. Subscribe to anything with a feed URL — blogs, news, podcasts, anything.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
            </svg>
          </div>
          <h3>Full-text search</h3>
          <p>Search across every entry from every feed. Find that article you read last month in seconds.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11.5 2 9.6 8.6 3 10.5l6.6 1.9L11.5 19l1.9-6.6 6.6-1.9-6.6-1.9L11.5 2Z" />
            </svg>
          </div>
          <h3>Star and save</h3>
          <p>Mark entries as starred to build a permanent reading list. Unread, read, and removed statuses keep your timeline clean.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2v11Z" />
            </svg>
          </div>
          <h3>Categories</h3>
          <p>Organize feeds into folders. Browse by topic, collapse what you're behind on, keep your sidebar tidy.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="6" rx="1" /><rect x="3" y="14" width="18" height="6" rx="1" /><path d="M7 7h.01M7 17h.01" />
            </svg>
          </div>
          <h3>Self-hostable</h3>
          <p>Run it on your own machine with Docker. Own your data end to end. Or use the hosted version and skip the setup.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       INTERFACES — same data, different surfaces (dark)
  ═════════════════════════════════════════════════════════════════ -->
  <section id="interfaces" class="interfaces" aria-labelledby="interfaces-heading">
    <div class="section-inner">
      <p class="kicker kicker-light">Three ways in</p>
      <h2 id="interfaces-heading" class="section-headline section-headline-light">
        Read from wherever you work.
      </h2>
      <p class="section-lede section-lede-light">
        The web app for browsing. The terminal UI for keyboard-driven reading.
        The CLI for scripts and automation. All backed by the same REST API.
      </p>

      <div class="interfaces-grid">
        <div class="interface-card">
          <div class="interface-badge">Web</div>
          <h3>A calm reading space</h3>
          <p>A sidebar for navigation, a timeline for scanning, a reader for long-form. Keyboard shortcuts, optimistic starring, infinite scroll.</p>
        </div>
        <div class="interface-card">
          <div class="interface-badge">TUI</div>
          <h3>Terminal-native</h3>
          <p>A full terminal user interface with vim-style navigation. Read feeds without leaving your terminal session.</p>
        </div>
        <div class="interface-card">
          <div class="interface-badge">CLI</div>
          <h3>Scriptable</h3>
          <p>Add feeds, list entries, mark as read — all from the command line. Pipe entries into your workflow.</p>
        </div>
      </div>

      <div class="code-sample code-sample-wide" role="region" aria-label="Sunred CLI sample">
        <div class="code-tabbar" aria-hidden="true">
          <span class="code-dot"></span>
          <span class="code-dot"></span>
          <span class="code-dot"></span>
          <span class="code-label">terminal</span>
        </div>
        <pre class="code-body"><code><span class="code-prompt">$</span> sunred feeds add https://example.com/feed.xml
<span class="code-comment"># Added "Example Blog" to Technology</span>

<span class="code-prompt">$</span> sunred list --unread
  planet4.local  Rust 2026 roadmap
  planet4.local  The end of Moore's law (again)
  planet4.local  Why RSS still matters

<span class="code-prompt">$</span> sunred read 1 --open</code></pre>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       FAQ
  ═════════════════════════════════════════════════════════════════ -->
  <section id="faq" class="faq" aria-labelledby="faq-heading">
    <div class="section-inner section-inner-narrow">
      <p class="kicker">Questions</p>
      <h2 id="faq-heading" class="section-headline">
        Good to know.
      </h2>

      <div class="faq-list">
        <details class="faq-item">
          <summary>What feed formats does Sunred support?</summary>
          <p>RSS 2.0, Atom 1.0, and JSON Feed. If a site publishes a feed in any of these formats, you can subscribe to it.</p>
        </details>
        <details class="faq-item">
          <summary>Do I need to host it myself?</summary>
          <p>No. You can use the hosted version and skip the setup. But if you want full control over your data, Sunred is open source and runs anywhere with Docker — a single command gets you a server, database, and web frontend.</p>
        </details>
        <details class="faq-item">
          <summary>Is there a mobile app?</summary>
          <p>The web app is fully responsive and works great on mobile browsers. There's no native app — the web interface is the app. The REST API means anyone could build one, too.</p>
        </details>
        <details class="faq-item">
          <summary>How does the terminal UI work?</summary>
          <p>The TUI is a terminal user interface — a full-screen, keyboard-driven reader that runs in your terminal. It supports vim-style navigation and gives you the same timeline, feeds, and entries as the web app.</p>
        </details>
        <details class="faq-item">
          <summary>Can I import my feeds from another reader?</summary>
          <p>Yes. Sunred supports OPML import. Export your feeds from any RSS reader (Feedly, Inoreader, NetNewsWire, etc.) as an OPML file and import them directly.</p>
        </details>
        <details class="faq-item">
          <summary>Is there tracking or advertising?</summary>
          <p>No. Sunred has no ads, no tracking, no analytics, no algorithmic feed. You see the entries from the feeds you subscribed to, in the order they were published.</p>
        </details>
        <details class="faq-item">
          <summary>What's the API like?</summary>
          <p>A clean REST API with JSON responses. Authenticate with a bearer token, then list feeds, add subscriptions, search entries, and more. Full documentation is in the docs.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       CLOSING CTA — the last push (dark)
  ═════════════════════════════════════════════════════════════════ -->
  <section class="closing-cta" aria-label="Get started">
    <div class="section-inner closing-inner">
      <Logo class="closing-mark" static />
      <h2 class="closing-headline">Start reading.</h2>
      <p class="closing-lede">
        Subscribe to your first feed in under a minute. No credit card, no
        setup wizard, no algorithm.
      </p>
      <div class="cta-row">
        <a class="cta cta-primary" href={loginUrl}>
          <span>Open the app</span>
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4.5 10h11m0 0-4.5-4.5M15.5 10 11 14.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="cta cta-secondary" href={selfHostUrl}>Self-host</a>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       FOOTER
  ═════════════════════════════════════════════════════════════════ -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <Logo class="footer-mark" static />
        <span>Sunred</span>
      </div>
      <nav class="footer-nav" aria-label="Footer">
        <a href={loginUrl}>Login</a>
        <a href={selfHostUrl}>Self-host</a>
        <a href="https://sunred.dev/docs">Docs</a>
        <a href="#features">Features</a>
        <a href="#faq">FAQ</a>
      </nav>
      <p class="footer-note">
        Open source. Self-hostable. Built for people who still read.
      </p>
    </div>
  </footer>
</Base>

<style>
  /* ── Skip link ────────────────────────────────────────────────── */

  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 100;
    padding: 0.625rem 1.25rem;
    background-color: var(--primary);
    color: var(--primary-foreground);
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.875rem;
    transition: top 0.2s ease;
  }

  .skip-link:focus {
    top: 1rem;
  }

  /* ── Hero ─────────────────────────────────────────────────────── */

  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    isolation: isolate;
  }

  /* Base sky — deep warm near-black */
  .sky-base {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(
        ellipse 90% 70% at 50% 85%,
        oklch(0.22 0.045 60) 0%,
        oklch(0.16 0.028 55) 40%,
        oklch(0.12 0.018 55) 100%
      );
  }

  /* Warming layer — fades in as the sun rises, tints the sky warmer */
  .sky-warm {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(
        ellipse 60% 50% at 50% 60%,
        oklch(0.3 0.08 65 / 0.35) 0%,
        oklch(0.25 0.05 60 / 0.15) 35%,
        transparent 70%
      );
    pointer-events: none;
  }

  /* Dawn haze — drifting low near the horizon */
  .haze {
    position: absolute;
    bottom: -10%;
    left: -10%;
    right: -10%;
    height: 45%;
    z-index: 2;
    background:
      radial-gradient(
        ellipse 80% 100% at 50% 100%,
        oklch(0.32 0.07 65 / 0.18) 0%,
        oklch(0.28 0.05 60 / 0.08) 40%,
        transparent 75%
      );
    filter: blur(20px);
    pointer-events: none;
  }

  /* The glow behind the sun */
  .sun-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -55%);
    width: clamp(280px, 50vw, 560px);
    height: clamp(280px, 50vw, 560px);
    z-index: 3;
    border-radius: 50%;
    background:
      radial-gradient(
        circle at center,
        color-mix(in oklab, var(--color-sun-glow) 45%, transparent) 0%,
        color-mix(in oklab, var(--primary) 25%, transparent) 30%,
        color-mix(in oklab, var(--color-sun-deep) 10%, transparent) 55%,
        transparent 70%
      );
    filter: blur(8px);
    pointer-events: none;
  }

  /* The sun logo */
  .sun-wrap {
    position: relative;
    z-index: 4;
    width: clamp(120px, 18vw, 200px);
    height: clamp(120px, 18vw, 200px);
    margin-bottom: clamp(2rem, 5vh, 3.5rem);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sun-logo-mark {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 50px color-mix(in oklab, var(--primary) 40%, transparent));
  }

  /* Content — wordmark, tagline, CTAs */
  .hero-content {
    position: relative;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 1.5rem;
    max-width: 42rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(3.5rem, 13vw, 7rem);
    line-height: 1;
    letter-spacing: -0.045em;
    color: oklch(0.97 0.015 79);
    margin: 0;
    text-wrap: balance;
  }

  .tagline {
    margin: 1.5rem 0 0;
    font-size: clamp(1.0625rem, 2.5vw, 1.375rem);
    line-height: 1.55;
    color: oklch(0.82 0.025 79);
    max-width: 32rem;
    font-weight: 400;
    text-wrap: pretty;
  }

  /* CTAs */
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
    margin-top: 2.5rem;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.5rem;
    border-radius: 0.625rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1;
    transition:
      transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.2s ease,
      border-color 0.2s ease;
    min-height: 48px;
  }

  .cta-primary {
    background-color: var(--primary);
    color: var(--primary-foreground);
  }

  .cta-primary:hover {
    background-color: var(--color-sun-glow);
    transform: translateY(-1px);
  }

  .cta-primary:active {
    transform: translateY(0);
  }

  .cta-secondary {
    background-color: transparent;
    color: oklch(0.92 0.015 79);
    border: 1px solid oklch(0.6 0.02 79 / 0.35);
  }

  .cta-secondary:hover {
    border-color: oklch(0.7 0.03 79 / 0.6);
    background-color: oklch(0.3 0.01 79 / 0.3);
    transform: translateY(-1px);
  }

  .cta-secondary:active {
    transform: translateY(0);
  }

  /* Scroll cue */
  .scroll-cue {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    color: oklch(0.7 0.02 79);
    opacity: 0.6;
  }

  /* ── Positioning section ───────────────────────────────────────── */

  .positioning {
    background-color: var(--paper);
    color: var(--ink);
    padding: clamp(5rem, 12vh, 9rem) 1.5rem;
  }

  .positioning-inner {
    max-width: 44rem;
    margin: 0 auto;
  }

  .kicker {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.875rem;
    color: color-mix(in oklab, var(--primary) 85%, var(--foreground));
    margin: 0 0 1rem;
    letter-spacing: 0.02em;
  }

  .positioning-headline {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    margin: 0 0 2.5rem;
    text-wrap: balance;
  }

  .positioning-body {
    font-size: 1.125rem;
    line-height: 1.7;
    max-width: 38rem;
  }

  .positioning-body p {
    margin: 0;
  }

  .positioning-body p + p {
    margin-top: 1.25rem;
  }

  /* ── Code sample ─────────────────────────────────────────────── */

  .code-sample {
    margin-top: clamp(3.5rem, 8vh, 5rem);
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--rule);
    background-color: oklch(0.18 0.006 79);
  }

  .code-tabbar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid oklch(0.28 0.006 79);
  }

  .code-dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background-color: oklch(0.3 0.006 79);
  }

  .code-dot:nth-child(1) {
    background-color: oklch(0.6 0.1 25);
  }

  .code-dot:nth-child(2) {
    background-color: oklch(0.62 0.14 85);
  }

  .code-dot:nth-child(3) {
    background-color: oklch(0.62 0.12 145);
  }

  .code-label {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: oklch(0.6 0.006 79);
  }

  .code-body {
    margin: 0;
    padding: 1.25rem 1.5rem;
