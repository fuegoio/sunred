---
import Base from "../layouts/Base.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import Cta from "../components/Cta.astro"
import PageHero from "../components/PageHero.astro"
import Closing from "../components/Closing.astro"
import SectionHead from "../components/SectionHead.astro"
import FeatureCell from "../components/FeatureCell.astro"
import CodeSample from "../components/CodeSample.astro"

const loginUrl = "/login"
const selfHostUrl = "https://github.com/fuegoio/sunred"

const featGroup = "border-t border-border py-[clamp(4rem,10vh,6.5rem)]"
const featGrid = "grid grid-cols-2 gap-5 max-[860px]:grid-cols-1"
const tagsUl =
  "mt-5 flex list-none flex-wrap gap-[0.4rem] p-0"
const tagsLi =
  "rounded-[0.3rem] border border-border px-[0.5rem] py-[0.2rem] font-mono text-[0.6875rem] text-muted-foreground"
---

<Base
  title="Features — Sunred"
  description="Everything an RSS reader should be: all feed formats, full-text search, starring, categories, social, self-hosting, and a clean REST API."
>
  <a
    href="#main"
    class="absolute -top-full left-4 z-[100] rounded-[0.5rem] bg-primary px-5 py-[0.625rem] text-sm font-semibold text-primary-foreground transition-[top] duration-200 focus:top-4"
  >
    Skip to content
  </a>
  <Nav active="features" />

  <PageHero label="Features">
    <h1
      class="mt-0 mb-6 font-sans text-[clamp(2.5rem,7vw,4.5rem)] font-semibold leading-[1.02] tracking-[-0.04em] text-foreground [text-wrap:balance]"
    >
      Everything an RSS reader should be.
    </h1>
    <p
      class="mt-0 max-w-[38rem] text-[clamp(1.125rem,2.5vw,1.375rem)] leading-[1.55] text-muted-foreground [text-wrap:pretty]"
    >
      No feature bloat. No tracking. Just the tools you need to subscribe,
      read, share, and self-host — across web, terminal, and CLI.
    </p>
  </PageHero>

  <main id="main">
    <!-- Reading -->
    <section class={featGroup} aria-labelledby="reading-heading">
      <div class="mx-auto max-w-[72rem] px-[clamp(1.25rem,4vw,2.5rem)]">
        <SectionHead mark="/ reading" headlineId="reading-heading">
          A calm space built for reading.
        </SectionHead>
        <div class={featGrid}>
          <FeatureCell title="All feed formats">
            <span slot="icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1" fill="currentColor" stroke="none"/></svg>
            </span>
            RSS 2.0, Atom 1.0, and JSON Feed. Subscribe to anything with a feed URL — blogs, news, podcasts, anything that publishes a feed.
            <ul slot="tags" class={tagsUl}>
              <li class={tagsLi}>RSS 2.0</li>
              <li class={tagsLi}>Atom 1.0</li>
              <li class={tagsLi}>JSON Feed</li>
            </ul>
          </FeatureCell>
          <FeatureCell title="Full-text search">
            <span slot="icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </span>
            Search across every entry from every feed. Find that article you read last month in seconds — the whole archive is indexed.
          </FeatureCell>
          <FeatureCell title="Star and save">
            <span slot="icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M11.5 2 9.6 8.6 3 10.5l6.6 1.9L11.5 19l1.9-6.6 6.6-1.9-6.6-1.9L11.5 2Z"/></svg>
            </span>
            Mark entries as starred for a permanent reading list. Unread, read, and removed statuses keep your timeline clean.
          </FeatureCell>
          <FeatureCell title="Categories">
            <span slot="icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2v11Z"/></svg>
            </span>
            Organize feeds into folders. Browse by topic, collapse what you're behind on, keep your sidebar tidy.
          </FeatureCell>
        </div>
      </div>
    </section>

    <!-- Social -->
    <section
      class:list={[featGroup, "bg-[color-mix(in_oklab,var(--background)_88%,black)]"]}
      aria-labelledby="social-feat-heading"
    >
      <div class="mx-auto max-w-[72rem] px-[clamp(1.25rem,4vw,2.5rem)]">
        <SectionHead
          mark="/ social"
          headlineId="social-feat-heading"
          lede="Follow people, share articles, and discover feeds through your network. Federated on the AT Protocol."
        >
          Reading with people you trust.
        </SectionHead>
        <div class={featGrid}>
          <FeatureCell title="Follow people">
            <span slot="icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </span>
            Find people by handle or name across instances. New follows are backfilled so you don't miss prior shares.
          </FeatureCell>
          <FeatureCell title="Share articles">
            <span slot="icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="m16 6-4-4-4 4"/><path d="M12 2v13"/></svg>
            </span>
            One click to share any entry. Your followers see it in their timeline with your name attached — no engagement metrics.
          </FeatureCell>
          <FeatureCell title="Public profiles">
            <span slot="icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>
            </span>
            Every user gets a public page with shared articles, public feeds, and federated follower counts.
          </FeatureCell>
          <FeatureCell title="Federated graph">
            <span slot="icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </span>
            Your follows and shares are AT Protocol records on your PDS. They travel with you across instances — no export step.
          </FeatureCell>
        </div>
        <div class="mt-10">
          <a
            href="/social"
            class="inline-flex items-center gap-[0.4rem] font-sans text-[0.9375rem] font-medium text-[color-mix(in_oklab,var(--primary)_85%,var(--foreground))] transition-[gap] duration-200 hover:gap-[0.6rem]"
          >
            Explore the social layer
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4.5 10h11m0 0-4.5-4.5M15.5 10 11 14.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Self-hosting -->
    <section class={featGroup} aria-labelledby="self-host-heading">
      <div class="mx-auto max-w-[72rem] px-[clamp(1.25rem,4vw,2.5rem)]">
        <SectionHead mark="/ self-hosting" headlineId="self-host-heading">
          Own your data, or skip the setup.
        </SectionHead>
        <div class={featGrid}>
          <FeatureCell title="Docker deploy">
            <span slot="icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="6" rx="1"/><rect x="3" y="14" width="18" height="6" rx="1"/><path d="M7 7h.01M7 17h.01"/></svg>
            </span>
            A single command gets you a server, database, and web frontend. Run it on a VPS, a Raspberry Pi, or your home server.
          </FeatureCell>
          <FeatureCell title="Own your data">
            <span slot="icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </span>
            Self-hosting means your feeds, reads, and stars live on your machine. No one else has them. Export anytime with OPML.
          </FeatureCell>
          <FeatureCell title="OPML import">
            <span slot="icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/><path d="M9 12l2 2 4-4"/></svg>
            </span>
            Export your feeds from Feedly, Inoreader, NetNewsWire, or any reader as OPML and import them directly. Switching is one file.
          </FeatureCell>
          <FeatureCell title="Hosted or self-hosted">
            <span slot="icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M2 12h20" opacity="0.4"/><path d="M12 2a10 10 0 0 1 0 20"/><path d="M12 2a10 10 0 0 0 0 20"/></svg>
            </span>
            Use the hosted version and skip the setup, or run your own. Same API, same interfaces, same social graph either way.
          </FeatureCell>
        </div>
        <div class="mt-10">
          <a
            href="/self-host"
            class="inline-flex items-center gap-[0.4rem] font-sans text-[0.9375rem] font-medium text-[color-mix(in_oklab,var(--primary)_85%,var(--foreground))] transition-[gap] duration-200 hover:gap-[0.6rem]"
          >
            Self-hosting guide
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4.5 10h11m0 0-4.5-4.5M15.5 10 11 14.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- API / CLI -->
    <section
      class:list={[featGroup, "bg-[color-mix(in_oklab,var(--background)_88%,black)]"]}
      aria-labelledby="api-heading"
    >
      <div class="mx-auto max-w-[72rem] px-[clamp(1.25rem,4vw,2.5rem)]">
        <SectionHead
          mark="/ api"
          headlineId="api-heading"
          lede="A clean REST API with JSON responses. Authenticate with a bearer token, then automate everything."
        >
          Scriptable end to end.
        </SectionHead>
        <div class="grid grid-cols-3 gap-5 max-[860px]:grid-cols-1">
          <FeatureCell title="REST API">
            <span slot="icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </span>
            List feeds, add subscriptions, search entries, share articles, follow people. JSON in, JSON out. Full OpenAPI spec in the docs.
          </FeatureCell>
          <FeatureCell title="CLI">
            <span slot="icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </span>
            Add feeds, list entries, mark as read, share, and follow — all from the command line. Pipe entries into your workflow.
          </FeatureCell>
          <FeatureCell title="TUI">
            <span slot="icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            </span>
            A full terminal user interface with vim-style navigation. Read and share feeds without leaving your terminal session.
          </FeatureCell>
        </div>

        <CodeSample label="API sample" class="mt-10">
          <span class="font-semibold text-primary">$</span> curl -H "Authorization: Bearer $TOKEN" \
              https://sunred.app/api/v1/entries?source=follows
          <span class="text-[oklch(0.6_0.012_50)]"># → entries shared by people you follow</span>

          <span class="font-semibold text-primary">$</span> curl -X POST -H "Authorization: Bearer $TOKEN" \
              -d "url=https://example.com/post" \
              https://sunred.app/api/v1/social/shares
          <span class="text-[oklch(0.6_0.012_50)]"># → shared to 14 followers</span>
        </CodeSample>
      </div>
    </section>
  </main>

  <Closing headline="Start reading." lede="Subscribe to your first feed in under a minute.">
    <Cta href={loginUrl} variant="primary">
      <span>Open the app</span>
      <svg class="h-[17px] w-[17px] shrink-0" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4.5 10h11m0 0-4.5-4.5M15.5 10 11 14.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </Cta>
    <Cta href={selfHostUrl} variant="ghost">Self-host</Cta>
  </Closing>

  <Footer />
</Base>
