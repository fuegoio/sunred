---
// The shared <head> for every page on the site. Both layouts use it:
// layouts/Base.astro (marketing, blog) and layouts/DocsBase.astro (docs).
// The layouts own what differs — stylesheets, the RSS autodiscovery link,
// and body/navigation behaviour.

interface Props {
  title: string
  description: string
  ogType?: "website" | "article"
  /** Include the blog RSS autodiscovery link. */
  rss?: boolean
  /** Social card image; docs pages pass their generated OG image. */
  ogImage?: string
  /** Browser tab title when it should differ from the card title. */
  windowTitle?: string
}

const {
  title,
  description,
  ogType = "website",
  rss = false,
  ogImage = "/favicon.svg",
  windowTitle,
} = Astro.props
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#fffffd" />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="Sunred" />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:image" content={ogImage} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
{
  rss && (
    <link rel="alternate" type="application/rss+xml" title="Sunred Blog" href="/blog/rss.xml" />
  )
}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700&family=Geist+Mono:wght@400;500;600&family=IBM+Plex+Sans:ital,wght@0,100..700;1,100..700&display=swap"
/>

<!-- Start light; honour the visitor's saved theme before the first paint. -->
<script is:inline>
  (function () {
    function savedThemeIsDark() {
      try {
        return localStorage.getItem("theme") === "dark";
      } catch (e) {
        /* Storage is optional; the page remains light when it is unavailable. */
        return false;
      }
    }

    function syncThemeColor(root, meta) {
      var isDark = root.classList.contains("dark");
      meta.setAttribute("content", isDark ? "#1a1815" : "#fffffd");
    }

    var root = document.documentElement;
    root.classList.toggle("dark", savedThemeIsDark());
    syncThemeColor(root, document.querySelector('meta[name="theme-color"]'));

    // Docs pages navigate client-side (astro:transitions ClientRouter). The
    // incoming page's <html> is prerendered light, so the swap would drop the
    // dark class; carry the saved theme over to the new document before the
    // swap runs.
    document.addEventListener("astro:before-swap", function (event) {
      var newRoot = event.newDocument.documentElement;
      newRoot.classList.toggle("dark", savedThemeIsDark());
      syncThemeColor(newRoot, event.newDocument.querySelector('meta[name="theme-color"]'));
    });
  })();
</script>

{
  import.meta.env.PROD && (
    <script
      is:inline
      defer
      src="https://umami.alexistac.net/script.js"
      data-website-id="c31ff124-7710-4ee7-bf24-d1cad767d72e"
    ></script>
  )
}

<title>{windowTitle ?? title}</title>
