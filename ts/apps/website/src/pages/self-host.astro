---
import Base from "../layouts/Base.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import Logo from "../components/Logo.astro"

const loginUrl = "/login"
const selfHostUrl = "https://github.com/fuegoio/sunred"
---

<Base title="Self-host — Sunred" description="Run Sunred on your own machine with Docker. Own your data end to end, or use the hosted version and skip the setup.">
  <a href="#main" class="skip-link">Skip to content</a>
  <Nav active="self-host" />

  <section class="page-hero" aria-label="Self-host">
    <div class="page-hero-glow" aria-hidden="true"></div>
    <div class="page-hero-inner reveal">
      <span class="tag">
        <span class="tag-dot"></span>
        Docker · Open source · MIT
      </span>
      <h1 class="page-hero-headline">
        Own your data,<br />or skip the setup.
      </h1>
      <p class="page-hero-lede">
        Sunred runs anywhere with Docker — a single command gets you a
        server, database, and web frontend. Or use the hosted version and
        start reading in under a minute. Same API, same interfaces, same
        social graph either way.
      </p>
      <div class="cta-row">
        <a class="cta cta-primary" href={selfHostUrl}>
          <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
          <span>View on GitHub</span>
        </a>
        <a class="cta cta-ghost" href={loginUrl}>Use the hosted version</a>
      </div>
    </div>
  </section>

  <main id="main">
    <!-- Install -->
    <section class="install-section" aria-labelledby="install-heading">
      <div class="section-inner section-inner-narrow">
        <header class="section-head">
          <span class="section-mark">/ install</span>
          <h2 id="install-heading" class="section-headline">One command.</h2>
          <p class="section-lede">
            Docker Compose brings up the Sunred server, database, and web
            frontend in one step. Point a domain at it and you're running.
          </p>
        </header>

        <div class="code-sample" role="region" aria-label="Docker install">
          <div class="code-tabbar" aria-hidden="true">
            <span class="code-dot"></span><span class="code-dot"></span><span class="code-dot"></span>
            <span class="code-label">terminal</span>
            <span class="code-spacer"></span>
            <span class="code-keys">bash</span>
          </div>
          <pre class="code-body"><code><span class="code-prompt">$</span> docker run -d -p 3000:3000 \
    -e DATABASE_URL=postgres://... \
    -v sunred-data:/data \
    sunred/sunred:latest

<span class="code-prompt">$</span> curl localhost:3000/api/v1/health
<span class="code-comment"># status: ok</span>

<span class="code-prompt">$</span> sunred feeds add https://example.com/feed.xml
<span class="code-comment"># Added "Example Blog" to Technology</span></code></pre>
        </div>

        <div class="install-grid">
          <div class="install-step">
            <span class="install-step-num">1</span>
            <h3>Run the container</h3>
            <p>One Docker command. Provide a database URL and a volume for data persistence. The server, web frontend, and scheduler all run in the same process.</p>
          </div>
          <div class="install-step">
            <span class="install-step-num">2</span>
            <h3>Point a domain at it</h3>
            <p>Put a reverse proxy (Caddy, nginx, Traefik) in front with TLS. The server respects <code class="inline-code">X-Forwarded-*</code> headers for redirects and canonical URLs.</p>
          </div>
          <div class="install-step">
            <span class="install-step-num">3</span>
            <h3>Add your feeds</h3>
            <p>Open the web app, create an account, and import your existing feeds with OPML. Or use the CLI to script everything.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Why self-host -->
    <section class="why-section" aria-labelledby="why-heading">
      <div class="section-inner">
        <header class="section-head">
          <span class="section-mark">/ why</span>
          <h2 id="why-heading" class="section-headline">Why self-host?</h2>
        </header>
        <div class="why-grid">
          <article class="feature-cell">
            <div class="feature-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3>Your data, your machine</h3>
            <p>Your feeds, read states, and stars live on your server. No third party has them. Your reading history is not a product.</p>
          </article>
          <article class="feature-cell">
            <div class="feature-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
            </div>
            <h3>No vendor lock-in</h3>
            <p>Open source under MIT. Export your feeds with OPML anytime. Your social graph is on your PDS, not in our database.</p>
          </article>
          <article class="feature-cell">
            <div class="feature-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            </div>
            <h3>Always available</h3>
            <p>No rate limits, no API quotas, no uptime dependency on someone else's infrastructure. Your reader is up when your server is up.</p>
          </article>
          <article class="feature-cell">
            <div class="feature-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/><path d="M9 12l2 2 4-4"/></svg>
            </div>
            <h3>Your rules</h3>
            <p>Configure the scheduler, tune polling, set retention policies. Full control over how feeds are fetched and how long entries are kept.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Hosted vs self-hosted -->
    <section class="compare-section" aria-labelledby="compare-heading">
      <div class="section-inner section-inner-narrow">
        <header class="section-head">
          <span class="section-mark">/ compare</span>
          <h2 id="compare-heading" class="section-headline">Hosted or self-hosted?</h2>
          <p class="section-lede">
            Same product. Same API. Same social graph. The only difference is
            where the data lives.
          </p>
        </header>

        <div class="compare-table">
          <div class="compare-row compare-head-row">
            <span></span>
            <span class="compare-col">Hosted</span>
            <span class="compare-col">Self-hosted</span>
          </div>
          <div class="compare-row">
            <span class="compare-label">Setup time</span>
            <span class="compare-val">Under a minute</span>
            <span class="compare-val">One Docker command</span>
          </div>
          <div class="compare-row">
            <span class="compare-label">Data location</span>
            <span class="compare-val">sunred.app servers</span>
            <span class="compare-val">Your machine</span>
          </div>
          <div class="compare-row">
            <span class="compare-label">Social graph</span>
            <span class="compare-val">Federated (AT Protocol)</span>
            <span class="compare-val">Federated (AT Protocol)</span>
          </div>
          <div class="compare-row">
            <span class="compare-label">REST API</span>
            <span class="compare-val check">Yes</span>
            <span class="compare-val check">Yes</span>
          </div>
          <div class="compare-row">
            <span class="compare-label">CLI / TUI</span>
            <span class="compare-val check">Yes</span>
            <span class="compare-val check">Yes</span>
          </div>
          <div class="compare-row">
            <span class="compare-label">Cost</span>
            <span class="compare-val">Free</span>
            <span class="compare-val">Your server</span>
          </div>
        </div>

        <div class="compare-cta">
          <a class="cta cta-primary" href={loginUrl}>
            <span>Try the hosted version</span>
            <svg class="cta-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4.5 10h11m0 0-4.5-4.5M15.5 10 11 14.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
          <a class="cta cta-ghost" href="https://sunred.dev/docs/self-hosting">Self-hosting docs</a>
        </div>
      </div>
    </section>
  </main>

  <section class="closing" aria-label="Get started">
    <div class="closing-glow" aria-hidden="true"></div>
    <div class="closing-inner">
      <Logo class="closing-mark" static />
      <h2 class="closing-headline">Your reader, your machine.</h2>
      <p class="closing-lede">Open source. Self-hostable. Yours.</p>
      <div class="cta-row">
        <a class="cta cta-primary" href={selfHostUrl}>
          <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
          <span>View on GitHub</span>
        </a>
        <a class="cta cta-ghost" href={loginUrl}>Use the hosted version</a>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style is:global>
  .page-hero .cta-row { margin-top: 2.5rem; }
  .page-hero .tag { margin-bottom: 1.75rem; }

  .install-section {
    padding: clamp(4rem, 10vh, 6.5rem) 0;
    border-top: 1px solid var(--color-rule);
  }
  .install-section .code-sample {
    margin-bottom: 2.5rem;
  }
  .install-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .install-step {
    padding: 1.75rem 1.6rem;
    border: 1px solid var(--color-rule);
    border-radius: 0.75rem;
    background-color: color-mix(in oklab, var(--color-bg-raised) 70%, transparent);
  }
  .install-step-num {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--primary);
    display: block;
    margin-bottom: 0.75rem;
  }
  .install-step h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
    color: var(--color-ink);
  }
  .install-step p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
  .inline-code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 0.1rem 0.35rem;
    border-radius: 0.3rem;
    border: 1px solid var(--color-rule);
    background-color: var(--color-bg-sunken);
    color: var(--color-ink-soft);
  }

  .why-section {
    padding: clamp(4rem, 10vh, 6.5rem) 0;
    border-top: 1px solid var(--color-rule);
  }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .compare-section {
    padding: clamp(4rem, 10vh, 6.5rem) 0;
    border-top: 1px solid var(--color-rule);
  }
  .compare-table {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-rule);
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .compare-row {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    align-items: center;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--color-rule);
    font-size: 0.9375rem;
  }
  .compare-row:last-child { border-bottom: none; }
  .compare-head-row {
    background-color: color-mix(in oklab, var(--color-bg-sunken) 50%, transparent);
    font-weight: 600;
    color: var(--color-ink);
  }
  .compare-col {
    font-family: var(--font-display);
    font-weight: 600;
    text-align: center;
  }
  .compare-label {
    color: var(--color-ink-soft);
    font-weight: 500;
  }
  .compare-val {
    text-align: center;
    color: var(--color-ink-soft);
  }
  .compare-val.check {
    color: var(--color-ink);
    font-weight: 500;
  }
  .compare-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  @media (max-width: 768px) {
    .install-grid { grid-template-columns: 1fr; }
    .why-grid { grid-template-columns: 1fr; }
    .compare-row {
      grid-template-columns: 1fr;
      gap: 0.3rem;
      padding: 1rem 1.25rem;
    }
    .compare-head-row { display: none; }
    .compare-label::before {
      content: attr(data-label);
    }
    .compare-val {
      text-align: left;
    }
    .compare-row {
      border-bottom: 1px solid var(--color-rule);
    }
  }
</style>
