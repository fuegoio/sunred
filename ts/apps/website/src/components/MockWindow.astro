---
interface Props {
  path?: string
  class?: string
}

const { path, class: className = "" } = Astro.props

const dots = [
  "bg-[oklch(0.7_0.14_30)]",
  "bg-[oklch(0.72_0.15_75)]",
  "bg-[oklch(0.68_0.16_145)]",
]
---

<div
  class:list={[
    "overflow-hidden rounded-[0.875rem] border border-rule-strong bg-bg-raised shadow-[0_1px_0_oklch(1_0_0/0.06)_inset,0_30px_80px_-30px_oklch(0_0_0/0.7)]",
    className,
  ]}
>
  <div
    class="flex items-center gap-2 border-b border-rule bg-[color-mix(in_oklab,var(--color-bg-raised)_85%,var(--color-bg-sunken))] px-[0.9rem] py-[0.7rem]"
  >
    {
      dots.map((d) => (
        <span class:list={["h-[0.7rem] w-[0.7rem] rounded-full", d]}></span>
      ))
    }
    {
      path && (
        <span class="ml-[0.6rem] font-mono text-[0.75rem] text-ink-soft">
          {path}
        </span>
      )
    }
    <slot name="trailing" />
  </div>
  <slot />
</div>
