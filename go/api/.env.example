# Sunred API configuration
# Copy to .env and adjust values.

# HTTP
SUNRED_HTTP_ADDR=:8080
SUNRED_BASE_URL=http://127.0.0.1:8080
SUNRED_WEB_URL=http://localhost:3000

# Database
SUNRED_DATABASE_URL=postgres://sunred:sunred@localhost:5432/sunred?sslmode=disable

# Logging: pretty or json
SUNRED_LOG_FORMAT=pretty
# Log level: debug, info, warn, error
SUNRED_LOG_LEVEL=info

# Scheduler
SUNRED_POLLING_FREQUENCY=60s
SUNRED_BATCH_SIZE=100
SUNRED_WORKER_POOL_SIZE=5
SUNRED_DISABLE_SCHEDULER=

# Feed fetching
SUNRED_HTTP_CLIENT_TIMEOUT=20s
SUNRED_HTTP_CLIENT_MAX_BODY=15728640

# Cleanup
SUNRED_CLEANUP_FREQUENCY=24h
SUNRED_ENTRY_MAX_AGE_DAYS=60

# AT Proto OAuth
# The client_id and callback URL derive from SUNRED_BASE_URL:
#   http://127.0.0.1:8080/client-metadata.json
#   http://127.0.0.1:8080/auth/oauth/callback
# For loopback dev, the localhost OAuth client config is used automatically
# (no metadata document fetch needed). The API redirects 127.0.0.1 callbacks
# to localhost so the session cookie is shared across ports 3000 and 8080.
# SUNRED_OAUTH_CLIENT_ID=

# Default PDS for the OAuth signup endpoint (/auth/oauth/signup). This is a
# server-side fallback; the web UI uses NEXT_PUBLIC_SUNRED_DEFAULT_PDS instead.
# Default is https://snrd.social. Set to empty to disable the signup endpoint.
SUNRED_DEFAULT_PDS=https://snrd.social

# Relay. When set, the API announces users to the relay and queries it for
# global counts. Leave empty to disable relay integration.
SUNRED_RELAY_URL=http://localhost:9090

# Session cookies
# Secure: mark cookies as Secure (required for cookies over HTTPS)
SUNRED_COOKIE_SECURE=false
# SameSite mode: lax, none, or strict. none requires SUNRED_COOKIE_SECURE=true
SUNRED_COOKIE_SAMESITE=lax
# Bare host to set as the cookie Domain (e.g. sunred.app) so the session is
# shared across subdomains (API and web app on different subdomains).
# Set to the registrable domain shared by both; leave unset for same-origin.
SUNRED_COOKIE_DOMAIN=
# Comma-separated list of allowed browser origins (e.g. https://app.sunred.app).
# Unset = any origin allowed (local development only).
# When set, SUNRED_WEB_URL is included automatically.
SUNRED_TRUSTED_ORIGINS=
