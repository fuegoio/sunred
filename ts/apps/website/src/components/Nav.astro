---
import Logo from "./Logo.astro"
import Cta from "./Cta.astro"

interface Props {
  active?: string
}

const { active } = Astro.props

const loginUrl = "/login"
const selfHostUrl = "https://github.com/fuegoio/sunred"

const links = [
  { href: "/features", label: "Features", key: "features" },
  { href: "/social", label: "Social", key: "social" },
  { href: "/self-host", label: "Self-host", key: "self-host" },
  { href: "/faq", label: "FAQ", key: "faq" },
  { href: "https://sunred.dev/docs", label: "Docs", key: "docs" },
]
---

<nav
  aria-label="Primary"
  class="sticky top-0 z-50 border-b border-border bg-[color-mix(in_oklab,var(--background)_78%,transparent)] backdrop-saturate-[1.6] backdrop-blur-[14px]"
>
  <div
    class="mx-auto flex max-w-[72rem] items-center justify-between gap-4 px-[clamp(1.25rem,4vw,2.5rem)] py-[0.85rem]"
  >
    <a
      class="flex items-center gap-2 font-sans text-[1.0625rem] font-semibold tracking-[-0.02em] text-foreground"
      href="/"
    >
      <Logo class="h-6 w-6 shrink-0" static />
      <span>Sunred</span>
      <span
        class="ml-[0.15rem] hidden rounded-[0.3rem] border border-border px-[0.4rem] py-[0.1rem] font-mono text-[0.6875rem] font-medium text-muted-foreground/70 md:inline"
      >
        v0.1
      </span>
    </a>
    <div class="hidden gap-7 text-[0.9375rem] font-medium md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              "transition-colors duration-150 hover:text-foreground",
              active === l.key ? "relative text-foreground" : "text-muted-foreground",
            ]}
          >
            {l.label}
            {active === l.key && (
              <span class="absolute -bottom-[0.95rem] left-0 right-0 h-[1.5px] rounded-[1px] bg-primary" />
            )}
          </a>
        ))
      }
    </div>
    <div class="flex items-center gap-[0.85rem]">
      <a
        class="max-sm:hidden text-[0.9375rem] font-medium text-muted-foreground transition-colors duration-150 hover:text-foreground"
        href={loginUrl}
      >
        Login
      </a>
      <Cta href={selfHostUrl} size="sm" variant="primary">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        <span>Self-host</span>
      </Cta>
    </div>
  </div>
</nav>
