---
import Base from "../layouts/Base.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import Logo from "../components/Logo.astro"

const loginUrl = "/login"
const selfHostUrl = "https://github.com/fuegoio/sunred"
---

<Base>
  <a href="#positioning-heading" class="skip-link">Skip to content</a>
  <Nav />

  <!-- ════════════════════════════════════════════════════════════════
       HERO
  ═════════════════════════════════════════════════════════════════ -->
  <section class="hero" aria-label="Hero">
    <div class="hero-glow" aria-hidden="true"></div>

    <div class="hero-grid">
      <div class="hero-copy">
        <span class="tag reveal">
          <span class="tag-dot"></span>
          RSS 2.0 · Atom · JSON Feed · Federated
        </span>

        <h1 class="hero-headline reveal">
          Your feeds,<br />
          <span class="hero-accent">your terms.</span>
        </h1>

        <p class="hero-tagline reveal">
          A modern, self-hostable RSS reader with a social graph on the
          AT Protocol. Follow people, share articles, and read what your
          trusted circle is reading. One timeline, no algorithm.
        </p>

        <div class="cta-row reveal">
          <a class="cta cta-primary" href={loginUrl}>
            <span>Open the app</span>
            <svg class="cta-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4.5 10h11m0 0-4.5-4.5M15.5 10 11 14.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a class="cta cta-ghost" href={selfHostUrl}>Self-host</a>
        </div>

        <div class="install-chip reveal" role="group" aria-label="Install command">
          <span class="install-prompt" aria-hidden="true">$</span>
          <code class="install-cmd">docker run sunred/sunred</code>
          <span class="install-copy" aria-hidden="true">copy</span>
        </div>
      </div>

      <!-- Product mock — the reader, with a shared entry -->
      <div class="hero-mock reveal" aria-hidden="true">
        <div class="mock-window">
          <div class="mock-titlebar">
            <span class="mock-traffic"></span>
            <span class="mock-traffic"></span>
            <span class="mock-traffic"></span>
            <span class="mock-path">sunred — Unread</span>
            <span class="mock-search">⌘K</span>
          </div>
          <div class="mock-body">
            <aside class="mock-sidebar">
              <div class="mock-sb-head">Feeds</div>
              <ul class="mock-feed-list">
                <li class="mock-feed is-active"><span class="mock-feed-mark"></span>Technology<span class="mock-count">12</span></li>
                <li class="mock-feed"><span class="mock-feed-mark"></span>Rust<span class="mock-count">4</span></li>
                <li class="mock-feed"><span class="mock-feed-mark"></span>Planets<span class="mock-count">3</span></li>
                <li class="mock-feed"><span class="mock-feed-mark"></span>Self-hosting<span class="mock-count">7</span></li>
              </ul>
              <div class="mock-sb-head mock-sb-follows">Follows</div>
              <ul class="mock-feed-list">
                <li class="mock-feed"><span class="mock-avatar"></span>@elena<span class="mock-count">3</span></li>
                <li class="mock-feed"><span class="mock-avatar"></span>@kael<span class="mock-count">1</span></li>
              </ul>
              <div class="mock-sb-foot">
                <span class="mock-star">★</span> Starred
              </div>
            </aside>
            <div class="mock-timeline">
              <!-- shared entry: from a followed user -->
              <div class="mock-entry is-selected is-shared">
                <span class="mock-unread"></span>
                <div class="mock-shared-by">
                  <span class="mock-shared-avatar"></span>
                  shared by <span class="mock-shared-handle">@elena</span>
                </div>
                <div class="mock-entry-title">Why RSS still matters</div>
                <div class="mock-entry-excerpt">
                  The web used to come to you. Then it stopped. Here's why the
                  oldest syndication format is quietly outliving the platforms…
                </div>
              </div>
              <div class="mock-entry">
                <span class="mock-unread"></span>
                <div class="mock-entry-meta"><span class="mock-entry-src">rust-lang.org</span><span class="mock-entry-time">5h</span></div>
                <div class="mock-entry-title">Rust 2026 roadmap</div>
                <div class="mock-entry-excerpt">A look at the language team's direction for the next edition…</div>
              </div>
              <div class="mock-entry">
                <span class="mock-unread"></span>
                <div class="mock-entry-meta"><span class="mock-entry-src">selfhosted.show</span><span class="mock-entry-time">8h</span></div>
                <div class="mock-entry-title">The end of Moore's law (again)</div>
                <div class="mock-entry-excerpt">Density gains slow, and what that means for the home lab…</div>
              </div>
              <div class="mock-entry is-read">
                <span class="mock-read-dot"></span>
                <div class="mock-entry-meta"><span class="mock-entry-src">planet4.local</span><span class="mock-entry-time">1d</span></div>
                <div class="mock-entry-title">A field guide to OPML</div>
                <div class="mock-entry-excerpt">Exporting and importing your subscriptions, explained…</div>
              </div>
            </div>
          </div>
        </div>
        <div class="mock-shadow" aria-hidden="true"></div>
      </div>
    </div>

    <div class="trust-strip reveal-fade">
      <span>Open source</span>
      <span class="trust-sep">·</span>
      <span>Self-hostable</span>
      <span class="trust-sep">·</span>
      <span>Federated on AT Protocol</span>
      <span class="trust-sep">·</span>
      <span>No ads, no tracking, no algorithm</span>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       MANIFESTO
  ═════════════════════════════════════════════════════════════════ -->
  <section class="manifesto" aria-labelledby="positioning-heading">
    <div class="manifesto-inner">
      <h2 id="positioning-heading" class="manifesto-headline">
        RSS is alive. It just needed a reader that&nbsp;respects&nbsp;you.
      </h2>

      <div class="manifesto-cols">
        <div class="manifesto-body">
          <p>
            Sunred fetches RSS 2.0, Atom, and JSON Feed into a single timeline
            you actually want to read. No ads, no tracking, no algorithm
            deciding what reaches you. Just the sources you chose, in a calm
            space built for reading.
          </p>
          <p>
            And now it's social: follow people, share articles, and discover
            feeds through the people you trust. Your social graph runs on the
            AT Protocol — the same one Bluesky uses — so it travels with you
            across instances. <a href="/social">Learn how it works →</a>
          </p>
        </div>
        <aside class="manifesto-pull">
          <p class="pull-quote">"Your feeds, your terms."</p>
          <p class="pull-attr">
            The one line worth remembering. Everything else is in service of it.
          </p>
        </aside>
      </div>

      <div class="code-sample reveal-fade" role="region" aria-label="Sunred CLI sample">
        <div class="code-tabbar" aria-hidden="true">
          <span class="code-dot"></span><span class="code-dot"></span><span class="code-dot"></span>
          <span class="code-label">terminal</span>
          <span class="code-spacer"></span>
          <span class="code-keys">bash</span>
        </div>
        <pre class="code-body"><code><span class="code-prompt">$</span> sunred feeds add https://example.com/feed.xml
<span class="code-comment"># Added "Example Blog" to Technology</span>

<span class="code-prompt">$</span> sunred follow @elena
<span class="code-comment"># Now following elena — backfilling 3 shares</span>

<span class="code-prompt">$</span> sunred list --unread
  planet4.local  Rust 2026 roadmap
  @elena         Why RSS still matters
  planet4.local  The end of Moore's law (again)</code></pre>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       SOCIAL — the new layer
  ═════════════════════════════════════════════════════════════════ -->
  <section class="social-preview" aria-labelledby="social-heading">
    <div class="section-inner">
      <header class="section-head">
        <span class="section-mark">/ social</span>
        <h2 id="social-heading" class="section-headline">
          Reading is better with people you trust.
        </h2>
        <p class="section-lede">
          Follow people and see the articles they share in your timeline.
          Your graph is federated on the AT Protocol — it travels with you
          when you move instances.
        </p>
      </header>

      <div class="social-cards">
        <article class="feature-cell social-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
          </div>
          <h3>Follow people</h3>
          <p>Find people by handle or name — across instances, not just yours. New follows are backfilled into your timeline.</p>
        </article>
        <article class="feature-cell social-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" /><path d="m16 6-4-4-4 4" /><path d="M12 2v13" />
            </svg>
          </div>
          <h3>Share articles</h3>
          <p>One click on any entry to share it. Your followers see it in their timeline with your name attached. No reposts, no engagement metrics.</p>
        </article>
        <article class="feature-cell social-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="5" /><path d="M20 21a8 8 0 0 0-16 0" />
            </svg>
          </div>
          <h3>Public profiles</h3>
          <p>Every user gets a public page with their shared articles, public feeds, and follower counts — local and federated.</p>
        </article>
      </div>

      <div class="social-cta">
        <a class="cta cta-ghost" href="/social">
          Explore the social layer
          <svg class="cta-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4.5 10h11m0 0-4.5-4.5M15.5 10 11 14.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       FEATURES — bento
  ═════════════════════════════════════════════════════════════════ -->
  <section id="features" class="features" aria-labelledby="features-heading">
    <div class="section-inner">
      <header class="section-head">
        <span class="section-mark">/ features</span>
        <h2 id="features-heading" class="section-headline">
          Everything an RSS reader should be.
        </h2>
        <p class="section-lede">
          No feature bloat. No tracking. Just the tools you need to subscribe,
          read, share, and self-host.
        </p>
      </header>

      <div class="bento">
        <article class="feature-cell bento-tall">
          <div class="feature-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 11a9 9 0 0 1 9 9" /><path d="M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1" fill="currentColor" stroke="none" />
            </svg>
          </div>
          <h3>All feed formats</h3>
          <p>RSS 2.0, Atom 1.0, and JSON Feed. Subscribe to anything with a feed URL — blogs, news, podcasts.</p>
          <ul class="feature-tags">
            <li>RSS 2.0</li><li>Atom 1.0</li><li>JSON Feed</li>
          </ul>
        </article>

        <article class="feature-cell bento-span4">
          <div class="feature-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
            </svg>
          </div>
          <h3>Full-text search</h3>
          <p>Search across every entry from every feed. Find that article you read last month in seconds — the whole archive is indexed.</p>
        </article>

        <article class="feature-cell">
          <div class="feature-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11.5 2 9.6 8.6 3 10.5l6.6 1.9L11.5 19l1.9-6.6 6.6-1.9-6.6-1.9L11.5 2Z" />
            </svg>
          </div>
          <h3>Star and save</h3>
          <p>Mark entries as starred for a permanent reading list. Unread, read, and removed statuses keep your timeline clean.</p>
        </article>

        <article class="feature-cell">
          <div class="feature-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2v11Z" />
            </svg>
          </div>
          <h3>Categories</h3>
          <p>Organize feeds into folders. Browse by topic, collapse what you're behind on, keep your sidebar tidy.</p>
        </article>

        <article class="feature-cell bento-full">
          <div class="feature-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="6" rx="1" /><rect x="3" y="14" width="18" height="6" rx="1" /><path d="M7 7h.01M7 17h.01" />
            </svg>
          </div>
          <h3>Self-hostable</h3>
          <p>Run it on your own machine with Docker. Own your data end to end. Or use the hosted version and skip the setup — same API, same interfaces either way.</p>
        </article>
      </div>

      <div class="features-more">
        <a class="link-arrow" href="/features">
          See all features
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4.5 10h11m0 0-4.5-4.5M15.5 10 11 14.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       INTERFACES
  ═════════════════════════════════════════════════════════════════ -->
  <section id="interfaces" class="interfaces" aria-labelledby="interfaces-heading">
    <div class="section-inner">
      <header class="section-head">
        <span class="section-mark">/ interfaces</span>
        <h2 id="interfaces-heading" class="section-headline">
          Read from wherever you work.
        </h2>
        <p class="section-lede">
          The web app for browsing. The terminal UI for keyboard-driven
          reading. The CLI for scripts and automation. All backed by the same
          REST API.
        </p>
      </header>

      <div class="interfaces-grid">
        <article class="interface-card">
          <div class="interface-mock mock-web" aria-hidden="true">
            <div class="mock-mini-bar"><span class="mm-dot"></span><span class="mm-dot"></span><span class="mm-dot"></span></div>
            <div class="mock-mini-body">
              <div class="mock-mini-side">
                <span class="mms"></span><span class="mms"></span><span class="mms"></span><span class="mms is-on"></span><span class="mms"></span>
              </div>
              <div class="mock-mini-main">
                <span class="mmm mmm-title"></span>
                <span class="mmm"></span>
                <span class="mmm"></span>
                <span class="mmm mmm-short"></span>
              </div>
            </div>
          </div>
          <div class="interface-badge">Web</div>
          <h3>A calm reading space</h3>
          <p>A sidebar for navigation, a timeline for scanning, a reader for long-form. Keyboard shortcuts, optimistic starring, infinite scroll.</p>
        </article>

        <article class="interface-card">
          <div class="interface-mock mock-tui" aria-hidden="true">
            <pre class="tui-screen"><code><span class="tui-hl">▸ Technology</span>      <span class="tui-dim">12</span>
  Rust 2026 roadmap    <span class="tui-dim">2h</span>
  @elena Why RSS…     <span class="tui-dim">2h</span>
<span class="tui-dim">▸ Self-hosting</span>     <span class="tui-dim">7</span>

<span class="tui-dim">j/k move  g/G top/bot</span>
<span class="tui-dim">o open    s share  ? help</span></code></pre>
          </div>
          <div class="interface-badge">TUI</div>
          <h3>Terminal-native</h3>
          <p>A full terminal user interface with vim-style navigation. Read and share feeds without leaving your terminal session.</p>
        </article>

        <article class="interface-card">
          <div class="interface-mock mock-cli" aria-hidden="true">
            <pre class="tui-screen"><code><span class="code-prompt">$</span> sunred follow @elena
<span class="tui-dim"># backfilling 3 shares</span>

<span class="code-prompt">$</span> sunred share 1
<span class="tui-dim"># shared to 14 followers</span>

<span class="code-prompt">$</span> sunred list --unread</code></pre>
          </div>
          <div class="interface-badge">CLI</div>
          <h3>Scriptable</h3>
          <p>Follow, share, list entries, mark as read — all from the command line. Pipe entries into your workflow.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       FAQ (short — full page at /faq)
  ═════════════════════════════════════════════════════════════════ -->
  <section class="faq" aria-labelledby="faq-heading">
    <div class="section-inner section-inner-narrow">
      <header class="section-head">
        <span class="section-mark">/ faq</span>
        <h2 id="faq-heading" class="section-headline">Good to know.</h2>
      </header>

      <div class="faq-list">
        <details class="faq-item">
          <summary>Is the social graph really federated?<span class="faq-toggle" aria-hidden="true"></span></summary>
          <div class="faq-answer">
            <p>Yes. Follows and shares are AT Protocol records on your own PDS. When you sign into another Sunred instance, your follows and shares come with you — no export/import step. See <a href="/social">the social page</a> for how it works.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>Do I need a Bluesky account?<span class="faq-toggle" aria-hidden="true"></span></summary>
          <div class="faq-answer">
            <p>No. Sunred uses the AT Protocol for identity and federation, which is the same protocol Bluesky uses. Your Sunred account is its own AT Proto identity. If you already have a Bluesky account, the protocols are compatible but the accounts are separate.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>Is there tracking or advertising?<span class="faq-toggle" aria-hidden="true"></span></summary>
          <div class="faq-answer">
            <p>No. Sunred has no ads, no tracking, no analytics, no algorithmic feed. You see the entries from the feeds you subscribed to and the articles shared by people you follow, in the order they were published.</p>
          </div>
        </details>
      </div>

      <div class="faq-more">
        <a class="link-arrow" href="/faq">
          All questions
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4.5 10h11m0 0-4.5-4.5M15.5 10 11 14.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       CLOSING CTA
  ═════════════════════════════════════════════════════════════════ -->
  <section class="closing" aria-label="Get started">
    <div class="closing-glow" aria-hidden="true"></div>
    <div class="closing-inner">
      <Logo class="closing-mark" static />
      <h2 class="closing-headline">Start reading.</h2>
      <p class="closing-lede">
        Subscribe to your first feed in under a minute. No credit card, no
        setup wizard, no algorithm.
      </p>
      <div class="cta-row">
        <a class="cta cta-primary" href={loginUrl}>
          <span>Open the app</span>
          <svg class="cta-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4.5 10h11m0 0-4.5-4.5M15.5 10 11 14.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="cta cta-ghost" href={selfHostUrl}>Self-host</a>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style is:global>
  /* ── Hero ─────────────────────────────────────────────────────── */

  .hero {
    position: relative;
    padding: clamp(3rem, 8vh, 5.5rem) clamp(1.25rem, 4vw, 2.5rem) clamp(3.5rem, 9vh, 6rem);
    overflow: hidden;
    isolation: isolate;
  }

  .hero-glow {
    position: absolute;
    top: -18%;
    left: 50%;
    transform: translateX(-50%);
    width: min(900px, 95vw);
    height: 620px;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle at center, oklch(0.74 0.2 45 / 0.16) 0%, oklch(0.6 0.16 50 / 0.07) 35%, transparent 68%);
    filter: blur(8px);
    animation: glow-bloom 1.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-grid {
    max-width: 72rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }
  .hero-copy {
    max-width: 34rem;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.75rem, 8vw, 5.25rem);
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 0 0 0;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .hero-accent {
    color: color-mix(in oklab, var(--primary) 92%, var(--color-ink));
  }
  .hero-tagline {
    margin: 1.5rem 0 0;
    font-size: clamp(1.0625rem, 2.4vw, 1.25rem);
    line-height: 1.6;
    color: var(--color-ink-soft);
    max-width: 32rem;
    font-weight: 400;
    text-wrap: pretty;
  }

  .install-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
    padding: 0.55rem 0.85rem;
    border-radius: 0.55rem;
    border: 1px solid var(--color-rule);
    background-color: var(--color-bg-sunken);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .install-prompt {
    color: var(--primary);
    font-weight: 600;
  }
  .install-cmd {
    color: var(--color-ink-soft);
  }
  .install-copy {
    margin-left: 0.5rem;
    padding: 0.15rem 0.45rem;
