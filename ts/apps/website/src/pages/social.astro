---
import Base from "../layouts/Base.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import Logo from "../components/Logo.astro"

const loginUrl = "/login"
const selfHostUrl = "https://github.com/fuegoio/sunred"
---

<Base title="Social — Sunred" description="Follow people, share articles, and see what others are reading. Federated on the AT Protocol.">
  <a href="#main" class="skip-link">Skip to content</a>
  <Nav active="social" />

  <!-- ════════════════════════════════════════════════════════════════
       HERO
  ═════════════════════════════════════════════════════════════════ -->
  <section class="page-hero" aria-label="Social">
    <div class="page-hero-glow" aria-hidden="true"></div>
    <div class="page-hero-inner reveal">
      <span class="tag">
        <span class="tag-dot"></span>
        Federated on the AT Protocol
      </span>
      <h1 class="page-hero-headline">
        Reading is better<br />with people you trust.
      </h1>
      <p class="page-hero-lede">
        Follow people and see the articles they share in your timeline.
        Your social graph runs on the same protocol as Bluesky — it travels
        with you across instances, not locked to one server.
      </p>
      <div class="cta-row">
        <a class="cta cta-primary" href={loginUrl}>
          <span>Open the app</span>
          <svg class="cta-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4.5 10h11m0 0-4.5-4.5M15.5 10 11 14.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="cta cta-ghost" href="https://sunred.dev/docs/product/social">Read the docs</a>
      </div>
    </div>
  </section>

  <main id="main">
    <!-- ════════════════════════════════════════════════════════════
         FOLLOW
    ════════════════════════════════════════════════════════════ -->
    <section class="feature-section" aria-labelledby="follow-heading">
      <div class="section-inner">
        <div class="feature-split">
          <div class="feature-text">
            <span class="section-mark">/ follow</span>
            <h2 id="follow-heading" class="section-headline">Follow people, not algorithms.</h2>
            <p class="section-lede">
              Find people by handle or name. Search spans your instance and,
              when a relay is configured, every other instance too.
            </p>
            <div class="prose">
              <p>When you follow someone, Sunred <strong>backfills their existing shares</strong> into your timeline — you don't miss what they shared before you found them.</p>
              <p>The people you follow appear under <strong>Follows</strong> in the sidebar, right below your feeds. Click a name to open their profile and follow or unfollow.</p>
            </div>
          </div>
          <div class="feature-visual" aria-hidden="true">
            <div class="mock-window sp-mock">
              <div class="mock-titlebar">
                <span class="mock-traffic"></span><span class="mock-traffic"></span><span class="mock-traffic"></span>
                <span class="mock-path">Find people</span>
              </div>
              <div class="sp-body">
                <div class="sp-search">
                  <span class="sp-search-icon">⌕</span>
                  <span class="sp-search-text">elena</span>
                  <span class="sp-search-cursor"></span>
                </div>
                <div class="sp-results">
                  <div class="sp-result">
                    <span class="sp-avatar"></span>
                    <div class="sp-result-info">
                      <span class="sp-result-name">Elena Vasquez</span>
                      <span class="sp-result-handle">@elena · sunred.app</span>
                    </div>
                    <span class="sp-follow">Following</span>
                  </div>
                  <div class="sp-result">
                    <span class="sp-avatar sp-avatar-2"></span>
                    <div class="sp-result-info">
                      <span class="sp-result-name">Elena K.</span>
                      <span class="sp-result-handle">@elena.dev · relay</span>
                    </div>
                    <span class="sp-follow sp-follow-cta">Follow</span>
                  </div>
                  <div class="sp-result">
                    <span class="sp-avatar sp-avatar-3"></span>
                    <div class="sp-result-info">
                      <span class="sp-result-name">elenas.blog</span>
                      <span class="sp-result-handle">@elena · other.instance</span>
                    </div>
                    <span class="sp-follow sp-follow-cta">Follow</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         SHARE
    ════════════════════════════════════════════════════════════ -->
    <section class="feature-section feature-section-alt" aria-labelledby="share-heading">
      <div class="section-inner">
        <div class="feature-split feature-split-reverse">
          <div class="feature-text">
            <span class="section-mark">/ share</span>
            <h2 id="share-heading" class="section-headline">One click to share.</h2>
            <p class="section-lede">
              Click the share icon on any entry. Your followers see it in
              their timeline with your name attached.
            </p>
            <div class="prose">
              <p>Sharing is an <strong>independent action</strong> — it doesn't change read status or starring. Share something you've already read, or star something you've shared.</p>
              <p>Shared articles appear in your followers' <strong>Unread</strong> and <strong>All</strong> views alongside their own subscriptions. If the article comes from a feed they don't subscribe to, they get a <strong>Subscribe</strong> button to add the source in one click.</p>
            </div>
          </div>
          <div class="feature-visual" aria-hidden="true">
            <div class="mock-window sp-mock">
              <div class="mock-titlebar">
                <span class="mock-traffic"></span><span class="mock-traffic"></span><span class="mock-traffic"></span>
                <span class="mock-path">sunred — Unread</span>
              </div>
              <div class="share-mock-body">
                <div class="share-entry is-shared">
                  <div class="share-entry-meta">
                    <span class="share-entry-src">rust-lang.org</span>
                    <span class="share-entry-time">5h</span>
                  </div>
                  <div class="share-entry-title">Rust 2026 roadmap</div>
                  <div class="share-entry-excerpt">A look at the language team's direction for the next edition…</div>
                  <div class="share-entry-actions">
                    <span class="share-action share-action-on">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="m16 6-4-4-4 4"/><path d="M12 2v13"/></svg>
                      Shared
                    </span>
                    <span class="share-action">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.5 2 9.6 8.6 3 10.5l6.6 1.9L11.5 19l1.9-6.6 6.6-1.9-6.6-1.9L11.5 2Z"/></svg>
                      Star
                    </span>
                  </div>
                </div>
                <div class="share-entry">
                  <div class="share-entry-meta">
                    <span class="share-entry-src">selfhosted.show</span>
                    <span class="share-entry-time">8h</span>
                  </div>
                  <div class="share-entry-title">The end of Moore's law (again)</div>
                  <div class="share-entry-excerpt">Density gains slow, and what that means for the home lab…</div>
                  <div class="share-entry-actions">
                    <span class="share-action">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="m16 6-4-4-4 4"/><path d="M12 2v13"/></svg>
                      Share
                    </span>
                    <span class="share-action">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.5 2 9.6 8.6 3 10.5l6.6 1.9L11.5 19l1.9-6.6 6.6-1.9-6.6-1.9L11.5 2Z"/></svg>
                      Star
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         PROFILES
    ════════════════════════════════════════════════════════════ -->
    <section class="feature-section" aria-labelledby="profiles-heading">
      <div class="section-inner">
        <div class="feature-split">
          <div class="feature-text">
            <span class="section-mark">/ profiles</span>
            <h2 id="profiles-heading" class="section-headline">Your profile is public.</h2>
            <p class="section-lede">
              Every user gets a public page at <code class="inline-code">/users/{`{handle}`}</code> with their shared articles, public feeds, and follower counts.
            </p>
            <div class="prose">
              <p>Profiles show follower and following counts with a <strong>federated split</strong> — how many are on your instance vs. how many are on other instances via the relay.</p>
              <p>Set your display name and bio under Settings. These are cached from your standard AT Proto profile record — the same one Bluesky uses.</p>
            </div>
          </div>
          <div class="feature-visual" aria-hidden="true">
            <div class="mock-window profile-mock">
              <div class="mock-titlebar">
                <span class="mock-traffic"></span><span class="mock-traffic"></span><span class="mock-traffic"></span>
                <span class="mock-path">/users/@elena</span>
              </div>
              <div class="profile-body">
                <div class="profile-masthead">
                  <span class="profile-avatar"></span>
                  <div class="profile-info">
                    <span class="profile-name">Elena Vasquez</span>
                    <span class="profile-handle">@elena</span>
                    <p class="profile-bio">Reading Rust, systems, and the open web. Sharing what matters.</p>
                  </div>
                  <span class="profile-follow-btn">Following</span>
                </div>
                <div class="profile-stats">
                  <div class="profile-stat">
                    <span class="profile-stat-num">1,247</span>
                    <span class="profile-stat-label">followers</span>
                  </div>
                  <div class="profile-stat">
                    <span class="profile-stat-num">89</span>
                    <span class="profile-stat-label">following</span>
                  </div>
                  <div class="profile-stat">
                    <span class="profile-stat-num">34</span>
                    <span class="profile-stat-label">articles shared</span>
                  </div>
                </div>
                <div class="profile-tabs">
                  <span class="profile-tab is-active">Articles</span>
                  <span class="profile-tab">Feeds</span>
                </div>
                <div class="profile-articles">
                  <div class="profile-article">
                    <span class="pa-title">Why RSS still matters</span>
                    <span class="pa-meta">planet4.local · 2h</span>
                  </div>
                  <div class="profile-article">
                    <span class="pa-title">Rust 2026 roadmap</span>
                    <span class="pa-meta">rust-lang.org · 5h</span>
                  </div>
                  <div class="profile-article">
                    <span class="pa-title">A field guide to OPML</span>
                    <span class="pa-meta">planet4.local · 1d</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         FEDERATION
    ════════════════════════════════════════════════════════════ -->
    <section class="feature-section feature-section-alt" aria-labelledby="federation-heading">
      <div class="section-inner">
        <div class="feature-split feature-split-reverse">
          <div class="feature-text">
            <span class="section-mark">/ federation</span>
            <h2 id="federation-heading" class="section-headline">Your graph travels with you.</h2>
            <p class="section-lede">
              Follows and shares are AT Protocol records on your own PDS.
              Sign into another Sunred instance and your social graph is there.
            </p>
            <div class="prose">
              <p>Sunred uses the AT Protocol for identity and federation — the same protocol Bluesky runs on. Your account is an AT Proto identity with its own DID and PDS (personal data server).</p>
              <p>Follows, shares, and feed subscriptions are <strong>records on your PDS</strong>, not rows in one server's database. A relay aggregates them across instances so follower counts, share counts, and search results span the whole network, not just your corner of it.</p>
              <p>You don't need a Bluesky account. You don't need to understand any of this. It just means your social graph is <strong>yours</strong>, and it moves when you do.</p>
            </div>
          </div>
          <div class="feature-visual" aria-hidden="true">
            <div class="federation-diagram">
              <div class="fed-node fed-you">
                <span class="fed-node-icon">●</span>
                <span class="fed-node-label">Your PDS</span>
                <span class="fed-node-sub">follows · shares · feeds</span>
              </div>
              <div class="fed-lines" aria-hidden="true">
                <span class="fed-line"></span>
                <span class="fed-line"></span>
                <span class="fed-line"></span>
              </div>
              <div class="fed-nodes">
                <div class="fed-node">
                  <span class="fed-node-icon fed-node-orange">●</span>
                  <span class="fed-node-label">Instance A</span>
                  <span class="fed-node-sub">sunred.app</span>
                </div>
                <div class="fed-node">
                  <span class="fed-node-icon fed-node-orange">●</span>
                  <span class="fed-node-label">Instance B</span>
                  <span class="fed-node-sub">self-hosted</span>
                </div>
                <div class="fed-node">
                  <span class="fed-node-icon fed-node-orange">●</span>
                  <span class="fed-node-label">Instance C</span>
                  <span class="fed-node-sub">other.host</span>
                </div>
              </div>
              <div class="fed-relay" aria-hidden="true">
                <span class="fed-relay-label">relay</span>
                <span class="fed-relay-sub">aggregates counts across instances</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         CLI / API
    ════════════════════════════════════════════════════════════ -->
    <section class="social-cli" aria-labelledby="cli-heading">
      <div class="section-inner section-inner-wide">
        <header class="section-head">
          <span class="section-mark">/ cli</span>
          <h2 id="cli-heading" class="section-headline">Social from the terminal.</h2>
          <p class="section-lede">
            Follow, share, and search people without leaving your shell.
            Same REST API the web app uses.
          </p>
        </header>

        <div class="code-sample" role="region" aria-label="Social CLI sample">
          <div class="code-tabbar" aria-hidden="true">
            <span class="code-dot"></span><span class="code-dot"></span><span class="code-dot"></span>
            <span class="code-label">terminal</span>
            <span class="code-spacer"></span>
            <span class="code-keys">bash</span>
          </div>
          <pre class="code-body"><code><span class="code-prompt">$</span> sunred search --users elena
  @elena           Elena Vasquez    sunred.app
  @elena.dev       Elena K.         relay → other.instance

<span class="code-prompt">$</span> sunred follow @elena
<span class="code-comment"># Now following @elena — backfilling 3 shares</span>

<span class="code-prompt">$</span> sunred share 1
<span class="code-comment"># Shared "Why RSS still matters" to 14 followers</span>

<span class="code-prompt">$</span> sunred following
  @elena    Elena Vasquez    3 shares
  @kael     Kael Wright      1 share</code></pre>
        </div>
      </div>
    </section>
  </main>

  <!-- ════════════════════════════════════════════════════════════════
       CLOSING CTA
  ═════════════════════════════════════════════════════════════════ -->
  <section class="closing" aria-label="Get started">
    <div class="closing-glow" aria-hidden="true"></div>
    <div class="closing-inner">
      <Logo class="closing-mark" static />
      <h2 class="closing-headline">Start following.</h2>
      <p class="closing-lede">
        Find people, share what you read, and let your graph travel with you.
      </p>
      <div class="cta-row">
        <a class="cta cta-primary" href={loginUrl}>
          <span>Open the app</span>
          <svg class="cta-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4.5 10h11m0 0-4.5-4.5M15.5 10 11 14.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="cta cta-ghost" href={selfHostUrl}>Self-host</a>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style is:global>
  .page-hero .cta-row { margin-top: 2.5rem; }
  .page-hero .tag { margin-bottom: 1.75rem; }

  /* ── Feature split ──────────────────────────────────────────── */

  .feature-section {
    padding: clamp(4rem, 10vh, 6.5rem) 0;
    border-top: 1px solid var(--color-rule);
  }
  .feature-section-alt {
    background-color: color-mix(in oklab, var(--color-bg-sunken) 50%, var(--color-bg));
  }
  .feature-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }
  .feature-split-reverse .feature-text { order: 2; }
  .feature-split-reverse .feature-visual { order: 1; }
  .feature-text { max-width: 36rem; }
  .feature-text .prose { margin-top: 1.5rem; }
  .inline-code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 0.1rem 0.35rem;
    border-radius: 0.3rem;
    border: 1px solid var(--color-rule);
    background-color: var(--color-bg-sunken);
    color: var(--color-ink-soft);
  }

  /* ── Follow search mock ────────────────────────────────────── */

  .sp-mock { max-width: 28rem; }
  .sp-body { padding: 1rem; }
  .sp-search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--color-rule);
    border-radius: 0.5rem;
    background-color: var(--color-bg-sunken);
    margin-bottom: 1rem;
  }
  .sp-search-icon {
    color: var(--color-ink-faint);
    font-size: 1rem;
  }
  .sp-search-text {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-ink);
  }
  .sp-search-cursor {
    width: 1.5px;
    height: 1rem;
    background-color: var(--primary);
    border-radius: 1px;
  }
  .sp-results {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .sp-result {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-rule);
    background-color: color-mix(in oklab, var(--color-bg-raised) 60%, transparent);
    transition: border-color 0.15s ease;
  }
  .sp-result:hover {
    border-color: var(--color-rule-strong);
  }
  .sp-avatar {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background-color: color-mix(in oklab, var(--primary) 40%, oklch(0.5 0.01 50));
    flex-shrink: 0;
  }
  .sp-avatar-2 { background-color: color-mix(in oklab, oklch(0.6 0.12 200) 50%, oklch(0.5 0.01 50)); }
  .sp-avatar-3 { background-color: color-mix(in oklab, oklch(0.6 0.12 300) 50%, oklch(0.5 0.01 50)); }
  .sp-result-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
    min-width: 0;
  }
  .sp-result-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .sp-result-handle {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-ink-faint);
  }
  .sp-follow {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.3rem 0.7rem;
    border-radius: 0.4rem;
    border: 1px solid var(--color-rule-strong);
    color: var(--color-ink-soft);
    flex-shrink: 0;
  }
  .sp-follow-cta {
    background-color: var(--primary);
    color: var(--primary-foreground);
    border-color: var(--primary);
  }

  /* ── Share entry mock ──────────────────────────────────────── */

  .share-mock-body { padding: 0.6rem; }
  .share-entry {
    padding: 0.85rem 1rem;
    border-radius: 0.55rem;
    border: 1px solid var(--color-rule);
    background-color: color-mix(in oklab, var(--color-bg-sunken) 40%, transparent);
    margin-bottom: 0.5rem;
  }
  .share-entry.is-shared {
    border-color: color-mix(in oklab, var(--primary) 30%, var(--color-rule-strong));
  }
  .share-entry-meta {
    display: flex;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-faint);
    margin-bottom: 0.3rem;
  }
  .share-entry-src { color: color-mix(in oklab, var(--primary) 80%, var(--color-ink-soft)); }
  .share-entry-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 0.25rem;
  }
  .share-entry-excerpt {
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
    margin-bottom: 0.6rem;
  }
  .share-entry-actions {
    display: flex;
    gap: 0.75rem;
  }
  .share-action {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-ink-faint);
  }
  .share-action-on {
    color: color-mix(in oklab, var(--primary) 85%, var(--color-ink));
  }

  /* ── Profile mock ──────────────────────────────────────────── */

  .profile-mock { max-width: 28rem; }
  .profile-body { padding: 1.25rem 1.25rem 1rem; }
  .profile-masthead {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }
  .profile-avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background-color: color-mix(in oklab, var(--primary) 40%, oklch(0.5 0.01 50));
    flex-shrink: 0;
  }
  .profile-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    flex: 1;
  }
  .profile-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .profile-handle {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-ink-faint);
  }
  .profile-bio {
    margin: 0.4rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
  .profile-follow-btn {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.35rem 0.8rem;
    border-radius: 0.4rem;
    border: 1px solid var(--color-rule-strong);
    color: var(--color-ink-soft);
    flex-shrink: 0;
  }
  .profile-stats {
    display: flex;
    gap: 1.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: 0.75rem;
  }
  .profile-stat {
