---
import "../styles/global.css"
import Head from "../components/Head.astro"

interface Props {
  title?: string
  description?: string
  ogType?: "website" | "article"
}

const {
  title = "Sunred — The web, back in your hands.",
  description = "Follow websites with RSS. Connect with people through AT Proto. Sunred is an open-source, self-hostable reader for a web that puts you first.",
  ogType = "website",
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} ogType={ogType} rss />
  </head>
  <body>
    <slot />
  </body>
</html>
