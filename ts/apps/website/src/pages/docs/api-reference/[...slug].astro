---
import { render } from "astro:content";
import { source } from "../../../lib/source";
import { getSidebarTree } from "../../../lib/sidebar-tree";
import { Docs } from "../../../components/docs/docs";
import DocsBase from "../../../layouts/DocsBase.astro";
import defaultMdxComponents from "fumadocs-ui/mdx";
import type { OpenAPIPageProps } from "fumadocs-openapi/ui";
import type { TOCItemType } from "fumadocs-core/toc";

// API reference: /docs/api-reference/*. Pages here come in two shapes:
// - spec pages generated by fumadocs-openapi (one per operation), and
// - the hand-written MDX index at src/content/docs/openapi/index.mdx.
export const prerender = true;

export async function getStaticPaths() {
  return source
    .getPages()
    .filter((p) => p.slugs[0] === "openapi")
    .map((p) => {
      const rest = p.slugs.slice(1);
      const params = { slug: rest.length ? rest.join("/") : undefined };
      if (p.type === "openapi") {
        return {
          params,
          props: {
            kind: "openapi" as const,
            toc: p.data.toc,
            title: p.data.title,
            description: p.data.description,
            api: p.data.getOpenAPIPageProps(),
          },
        };
      }
      return { params, props: { kind: "mdx" as const, page: p.data._raw } };
    });
}

const spec = "api" in Astro.props ? Astro.props : undefined;
const entry = spec ? undefined : Astro.props.page;
const { Content, headings } = entry ? await render(entry) : { Content: undefined, headings: [] };

const toc: TOCItemType[] = spec
  ? spec.toc
  : headings.map((heading) => ({
      depth: heading.depth,
      title: heading.text,
      url: "#" + heading.slug,
    }));

const title = spec ? spec.title : entry!.data.title;
const description = spec ? spec.description : entry!.data.description;
---

<DocsBase title={title} description={description}>
  {
    spec ? (
      <Docs
        tree={getSidebarTree()}
        pathname={Astro.url.pathname}
        params={Astro.params}
        page={{ toc, full: true }}
        api={spec.api as OpenAPIPageProps}
        apiTitle={spec.title}
        apiDescription={spec.description}
        client:load
      />
    ) : (
      <Docs
        tree={getSidebarTree()}
        pathname={Astro.url.pathname}
        params={Astro.params}
        page={{ toc }}
        prose
        client:load
      >
        <h1 class="font-semibold text-3xl">{title}</h1>
        <p class="text-lg text-fd-muted-foreground mb-8">{description}</p>
        <div class="prose flex-1">
          <Content components={{ ...defaultMdxComponents }} />
        </div>
      </Docs>
    )
  }
</DocsBase>
