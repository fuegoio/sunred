---
import "../styles/docs.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Sunred Docs", description = "Documentation for Sunred." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fffffd" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Sunred" />
    <meta property="og:image" content="/favicon.svg" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700&family=Geist+Mono:wght@400;500;600&family=IBM+Plex+Sans:ital,wght@0,100..700;1,100..700&display=swap"
    />

    <!-- Start light; honour the visitor's saved theme before the first paint. -->
    <script is:inline>
      (function () {
        var isDark = false;
        try {
          isDark = localStorage.getItem("theme") === "dark";
        } catch (e) {
          /* Storage is optional; the page remains light when it is unavailable. */
        }
        document.documentElement.classList.toggle("dark", isDark);
        document
          .querySelector('meta[name="theme-color"]')
          .setAttribute("content", isDark ? "#1a1815" : "#fffffd");
      })();
    </script>

    <!-- Client-side navigation between docs pages (fumadocs' sidebar and TOC). -->
    <ClientRouter />

    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://umami.alexistac.net/script.js"
          data-website-id="c31ff124-7710-4ee7-bf24-d1cad767d72e"
        ></script>
      )
    }

    <title>{title}</title>
  </head>
  <body class="flex flex-col min-h-screen">
    <slot />
  </body>
</html>
