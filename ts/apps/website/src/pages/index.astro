---
import Base from "../layouts/Base.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import Cta from "../components/Cta.astro"
import Logo from "../components/Logo.astro"

const loginUrl = "/login"
const selfHostUrl = "https://github.com/fuegoio/sunred"
---

<Base>
  <a href="#main" class="skip-link">Skip to content</a>
  <Nav />

  <main id="main" tabindex="-1">
    <section class="hero page-width" aria-labelledby="hero-heading">
      <div class="hero-copy">
        <p class="hero-intro">An RSS reader. An open web. A fresh start.</p>
        <h1 id="hero-heading">The web, back<br />in your hands.</h1>
        <p class="hero-description">
          Follow the sites you love with <strong>RSS</strong>.
          Connect with people through <strong>AT Proto</strong>.
          Sunred brings them together in a reader that puts you first.
        </p>
        <div class="hero-actions">
          <Cta href={loginUrl}>
            Open the app
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </Cta>
          <a class="text-link" href={selfHostUrl}>Or host it yourself <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12 12 4M4 4h8v8" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
        </div>
        <p class="hero-note">Open source. Self-hostable.</p>
      </div>
      <div class="dawn" aria-hidden="true">
        <div class="dawn-sky"><Logo class="dawn-sun" static /></div>
        <div class="dawn-horizon"></div>
        <p>A new day for the open web.</p>
      </div>
    </section>

    <figure class="app-preview page-width">
      <div class="preview-frame">
        <div class="preview-toolbar" aria-hidden="true">
          <span class="preview-dot"></span>
          <span>Sunred / Your reading space</span>
          <span class="preview-status">Your feeds. Your pace.</span>
        </div>
        <div class="preview-viewport">
          <img
            src="/app.light.png"
            alt="Sunred's reading list, with subscribed feeds on the left and articles in a chronological timeline."
            width="1559"
            height="1023"
            fetchpriority="high"
            class="preview-light"
          />
          <img
            src="/app.dark.png"
            alt="Sunred's reading list, with subscribed feeds on the left and articles in a chronological timeline."
            width="1559"
            height="1023"
            loading="lazy"
            class="preview-dark"
          />
        </div>
      </div>
      <figcaption>
        <span>A little less scrolling. A little more reading.</span>
        <a class="text-link" href="/docs/cli">Also at home in your terminal <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12 12 4M4 4h8v8" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
      </figcaption>
    </figure>

    <section id="protocols" class="protocols page-width" aria-labelledby="protocols-heading">
      <div class="protocols-intro">
        <h2 id="protocols-heading">Open protocols.<br />Not another platform.</h2>
        <p>The internet was made for people, not platforms. Let's get back to that.</p>
      </div>
      <div class="protocol-list">
        <article class="protocol">
          <h3 class="protocol-name">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="5" cy="19" r="2" fill="currentColor"></circle>
              <path d="M3 10a11 11 0 0 1 11 11M3 3a18 18 0 0 1 18 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
            </svg>
            RSS
          </h3>
          <div>
            <p class="protocol-heading">Your curiosity sets the feed.</p>
            <p>Blogs, news, independent voices. Subscribe to the websites you care about and get their latest posts in one place. Newest first. Nothing ranked for you.</p>
            <p class="protocol-detail">RSS, Atom &amp; JSON Feed. Bring your subscriptions with OPML.</p>
          </div>
        </article>
        <article class="protocol">
          <h3 class="protocol-name"><span class="at-mark" aria-hidden="true">@</span> AT Proto</h3>
          <div>
            <p class="protocol-heading">Good reading is better shared.</p>
            <p>Follow people and share articles across Sunred instances. Built on AT Protocol, the same open network as Bluesky, with an identity that isn't tied to one app.</p>
            <a class="text-link protocol-detail" href="/docs/at-proto">How federation works <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12 12 4M4 4h8v8" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
          </div>
        </article>
      </div>
    </section>

    <section class="closing page-width" aria-labelledby="closing-heading">
      <div>
        <h2 id="closing-heading">Your web. Your way.</h2>
        <p>Use our instance, or run your own. The code is open.<br class="desktop-break" /> The choice is yours.</p>
      </div>
      <div class="closing-actions">
        <Cta href={loginUrl}>
          Open the app
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </Cta>
        <a class="text-link" href={selfHostUrl}>Self-host Sunred <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12 12 4M4 4h8v8" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
      </div>
    </section>
  </main>

  <Footer />
</Base>
