---
import "../styles/docs.css";
import { ClientRouter } from "astro:transitions";
import Head from "../components/Head.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title = "Sunred Docs", description = "Documentation for Sunred.", ogImage } =
  Astro.props;

// Compose the window title ("Feeds — Sunred Docs"); the social card title
// stays bare since the card already carries the brand row. The product
// index page is titled "Sunred" — that one becomes "Sunred Docs" instead
// of the redundant "Sunred — Sunred Docs".
const windowTitle =
  title === "Sunred Docs" || title === "Sunred" ? "Sunred Docs" : `${title} — Sunred Docs`;
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={title}
      description={description}
      ogImage={ogImage}
      windowTitle={windowTitle}
    />
    <!-- Client-side navigation between docs pages (fumadocs' sidebar and TOC). -->
    <ClientRouter />
  </head>
  <!--
    transition:persist keeps this body across navigations and
    transition:animate="none" disables Astro's default crossfade, so moving
    between docs pages is instant like the rest of the site.
  -->
  <body class="flex flex-col min-h-screen" transition:persist transition:animate="none">
    <slot />
  </body>
</html>
