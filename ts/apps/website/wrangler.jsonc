{
  // Worker name and bindings for the website front door (Astro on Workers).
  // The Cloudflare adapter generates the assets/worker settings at build
  // time; this file only carries what's specific to us.
  "name": "sunred-website",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true,
  },
  "assets": {
    // Keep the non-slash URLs the site has always used
    // (/docs, /blog/...) — Workers assets default to adding a trailing
    // slash, which would change every canonical URL.
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
  },
  "vars": {
    // Origin of the Next.js app the catch-all proxy forwards to. It must be
    // reachable from Workers (app.sunred.app is Cloudflare-proxied, so it
    // is). Override locally with a .dev.vars file
    // (APP_URL=http://localhost:3000).
    "APP_URL": "https://app.sunred.app",
  },
}
