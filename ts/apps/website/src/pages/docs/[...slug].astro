---
import { render } from "astro:content";
import { source } from "../../lib/source";
import { getSidebarTree } from "../../lib/sidebar-tree";
import { Docs } from "../../components/docs/docs";
import DocsBase from "../../layouts/DocsBase.astro";
import defaultMdxComponents from "fumadocs-ui/mdx";
import type { TOCItemType } from "fumadocs-core/toc";

// Product docs: the section served at the root of /docs.
export const prerender = true;

export async function getStaticPaths() {
  return source
    .getPages()
    .filter((p) => p.slugs[0] === "product")
    .map((p) => {
      const rest = p.slugs.slice(1);
      return {
        params: { slug: rest.length ? rest.join("/") : undefined },
        props: { page: p.data._raw },
      };
    });
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
const toc: TOCItemType[] = headings.map((heading) => ({
  depth: heading.depth,
  title: heading.text,
  url: "#" + heading.slug,
}));
---

<DocsBase title={page.data.title} description={page.data.description}>
  <Docs
    tree={getSidebarTree()}
    pathname={Astro.url.pathname}
    params={Astro.params}
    page={{ toc }}
    prose
    client:load
  >
    <h1 class="font-semibold text-3xl">{page.data.title}</h1>
    {
      page.data.description && (
        <p class="text-lg text-fd-muted-foreground mb-8">{page.data.description}</p>
      )
    }
    <div class="prose flex-1">
      <Content components={{ ...defaultMdxComponents }} />
    </div>
  </Docs>
</DocsBase>
